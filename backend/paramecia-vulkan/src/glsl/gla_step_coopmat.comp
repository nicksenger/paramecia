// Gated Linear Attention (GLA) Single-Token Step with Cooperative Matrix
//
// Uses VK_KHR_cooperative_matrix for accelerated matrix operations.
// Computes single-token autoregressive GLA step with tile-based computation.
//
// Algorithm (same as standard version):
//   1. L2 normalize Q (with scale) and K
//   2. Decay state: new_state = state * exp(gate)
//   3. Compute kv_mem: kv_mem[i] = sum_j(new_state[i,j] * k[j])
//   4. Compute delta: delta[i] = (v[i] - kv_mem[i]) * sigmoid(beta)
//   5. Update state: new_state[i,j] += k[j] * delta[i]
//   6. Output: out[i] = sum_j(new_state[i,j] * q[j])
//
// Dispatch: (batch_heads, 1, 1) with workgroup size (32, 1, 1)

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

#ifndef HEAD_DIM
#define HEAD_DIM 128
#endif

// Tile sizes (configured at runtime via specialization constants)
layout(constant_id = 0) const uint TILE_M = 16;
layout(constant_id = 1) const uint TILE_N = 16;
layout(constant_id = 2) const uint TILE_K = 16;

// Workgroup size: one subgroup
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint batch_heads;
    uint d;
    float scale;
    float eps;
};

layout(set = 0, binding = 0, std430) readonly buffer QBuf { float v_q[]; };
layout(set = 0, binding = 1, std430) readonly buffer KBuf { float v_k[]; };
layout(set = 0, binding = 2, std430) readonly buffer VBuf { float v_v[]; };
layout(set = 0, binding = 3, std430) readonly buffer GateBuf { float v_gate[]; };
layout(set = 0, binding = 4, std430) readonly buffer BetaBuf { float v_beta[]; };
layout(set = 0, binding = 5, std430) readonly buffer StateBuf { float v_state[]; };
layout(set = 0, binding = 6, std430) buffer NewStateBuf { float v_new_state[]; };
layout(set = 0, binding = 7, std430) writeonly buffer OutBuf { float v_out[]; };

// Shared memory for cooperative matrix operations
shared float16_t shared_state[32 * 32];   // State matrix tiles
shared float16_t shared_vec[32];          // Vector tiles
shared float temp_result[32];             // Temporary results

// Shared memory for full vectors
shared float s_q[HEAD_DIM];
shared float s_k[HEAD_DIM];
shared float s_v[HEAD_DIM];
shared float s_kv_mem[HEAD_DIM];
shared float s_delta[HEAD_DIM];
shared float s_output[HEAD_DIM];
shared float s_norm[2]; // [q_rsqrt_norm, k_rsqrt_norm]

void main() {
    uint bh = gl_WorkGroupID.x;  // batch_head index
    uint tid = gl_LocalInvocationID.x;  // thread id within subgroup

    if (bh >= batch_heads) return;

    // Load q, k, v into shared memory (raw, un-normalized)
    for (uint i = tid; i < d; i += 32) {
        uint qkv_idx = bh * d + i;
        s_q[i] = v_q[qkv_idx];
        s_k[i] = v_k[qkv_idx];
        s_v[i] = v_v[qkv_idx];
    }
    barrier();

    // Compute L2 norm squared for Q and K
    float q_sum = 0.0;
    float k_sum = 0.0;
    for (uint i = tid; i < d; i += 32) {
        q_sum += s_q[i] * s_q[i];
        k_sum += s_k[i] * s_k[i];
    }

    // Reduce within subgroup
    q_sum = subgroupAdd(q_sum);
    k_sum = subgroupAdd(k_sum);

    // Thread 0 computes normalization factors
    if (tid == 0) {
        s_norm[0] = inversesqrt(q_sum + eps);
        s_norm[1] = inversesqrt(k_sum + eps);
    }
    barrier();

    // Normalize Q and K
    for (uint i = tid; i < d; i += 32) {
        s_q[i] *= scale * s_norm[0];
        s_k[i] *= s_norm[1];
    }
    barrier();

    // Load gate and beta
    float g = exp(v_gate[bh]);
    float beta_val = v_beta[bh];
    float b = 1.0 / (1.0 + exp(-beta_val));  // sigmoid

    uint state_base = bh * d * d;

    // Step 1: Decay state and copy to new_state
    for (uint i = tid; i < d * d; i += 32) {
        v_new_state[state_base + i] = v_state[state_base + i] * g;
    }
    barrier();

    // Step 2: Compute kv_mem = state @ k using tile-based computation
    for (uint i = tid; i < d; i += 32) {
        s_kv_mem[i] = 0.0;
    }
    barrier();

    uint num_tiles_m = (d + TILE_M - 1) / TILE_M;
    uint num_tiles_k = (d + TILE_K - 1) / TILE_K;

    for (uint tile_m = 0; tile_m < num_tiles_m; tile_m++) {
        float acc = 0.0;

        for (uint tile_k = 0; tile_k < num_tiles_k; tile_k++) {
            uint m_start = tile_m * TILE_M;
            uint k_start = tile_k * TILE_K;

            // Load state tile
            for (uint i = tid; i < TILE_M * TILE_K; i += 32) {
                uint m_idx = m_start + (i / TILE_K);
                uint k_idx = k_start + (i % TILE_K);

                float val = 0.0;
                if (m_idx < d && k_idx < d) {
                    val = v_new_state[state_base + m_idx * d + k_idx];
                }
                shared_state[i] = float16_t(val);
            }

            // Load k tile
            for (uint i = tid; i < TILE_K; i += 32) {
                uint k_idx = k_start + i;
                float val = (k_idx < d) ? s_k[k_idx] : 0.0;
                shared_vec[i] = float16_t(val);
            }

            barrier();

            // Compute partial dot product
            if (tid < TILE_M) {
                float partial = 0.0;
                for (uint k = 0; k < TILE_K; k++) {
                    partial += float(shared_state[tid * TILE_K + k]) * float(shared_vec[k]);
                }
                acc += partial;
            }

            barrier();
        }

        // Store result
        if (tid < TILE_M) {
            uint m_idx = tile_m * TILE_M + tid;
            if (m_idx < d) {
                s_kv_mem[m_idx] = acc;
            }
        }
        barrier();
    }

    // Step 3: Compute delta = (v - kv_mem) * sigmoid(beta)
    for (uint i = tid; i < d; i += 32) {
        s_delta[i] = (s_v[i] - s_kv_mem[i]) * b;
    }
    barrier();

    // Step 4: Update state with outer product: state += k ⊗ delta
    for (uint i = tid; i < d * d; i += 32) {
        uint row = i / d;
        uint col = i % d;
        v_new_state[state_base + i] += s_k[col] * s_delta[row];
    }
    barrier();

    // Step 5: Compute output = state @ q using tile-based computation
    for (uint i = tid; i < d; i += 32) {
        s_output[i] = 0.0;
    }
    barrier();

    for (uint tile_m = 0; tile_m < num_tiles_m; tile_m++) {
        float acc = 0.0;

        for (uint tile_k = 0; tile_k < num_tiles_k; tile_k++) {
            uint m_start = tile_m * TILE_M;
            uint k_start = tile_k * TILE_K;

            // Load state tile
            for (uint i = tid; i < TILE_M * TILE_K; i += 32) {
                uint m_idx = m_start + (i / TILE_K);
                uint k_idx = k_start + (i % TILE_K);

                float val = 0.0;
                if (m_idx < d && k_idx < d) {
                    val = v_new_state[state_base + m_idx * d + k_idx];
                }
                shared_state[i] = float16_t(val);
            }

            // Load q tile (reusing shared_vec)
            for (uint i = tid; i < TILE_K; i += 32) {
                uint k_idx = k_start + i;
                float val = (k_idx < d) ? s_q[k_idx] : 0.0;
                shared_vec[i] = float16_t(val);
            }

            barrier();

            // Compute partial dot product
            if (tid < TILE_M) {
                float partial = 0.0;
                for (uint k = 0; k < TILE_K; k++) {
                    partial += float(shared_state[tid * TILE_K + k]) * float(shared_vec[k]);
                }
                acc += partial;
            }

            barrier();
        }

        // Store result
        if (tid < TILE_M) {
            uint m_idx = tile_m * TILE_M + tid;
            if (m_idx < d) {
                s_output[m_idx] = acc;
            }
        }
        barrier();
    }

    // Write output
    for (uint i = tid; i < d; i += 32) {
        v_out[bh * d + i] = s_output[i];
    }
}
