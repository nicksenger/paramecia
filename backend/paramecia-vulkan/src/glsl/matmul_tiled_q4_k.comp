// Hierarchical Tiled Q4_K Matrix Multiplication
//
// Computes: C[m,n] = A[m,k] * B[n,k]^T
// Where B is Q4_K quantized (256 elements per block, 144 bytes each)
//
// Q4_K block structure (144 bytes):
// - Bytes 0-1: f16 d (global scale)
// - Bytes 2-3: f16 dmin (global min scale)
// - Bytes 4-15: packed 6-bit scales and mins for 8 groups
// - Bytes 16-143: packed 4-bit values (2 per byte)

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q4_K constants
#define QK4_K 256       // Elements per Q4_K block
#define QK4_K_BYTES 144 // Bytes per block

// Tile configuration
#define BM 16   // Block M
#define BN 64   // Block N
#define BK 32   // Block K (Q4_K block is 256 = 8*32)
#define WM 16   // Warp M
#define WN 32   // Warp N
#define TM 8    // Thread M tile
#define TN 8    // Thread N tile
#define WMITER 1

#include "matmul_tiled_common.glsl"

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint params[8];
};

#define op_m          params[0]
#define op_k          params[1]
#define op_n          params[2]
#define op_a_stride_b params[3]
#define op_a_offset   params[4]
#define op_a_stride_k params[5]
#define op_a_stride_m params[6]

layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

layout(set = 0, binding = 1, std430) readonly buffer InputA {
    float v_input_a[];
};

layout(set = 0, binding = 2, std430) readonly buffer InputB {
    uint v_input_b[];
};

// Shared memory for tiles
shared float shared_a[BM * SHMEM_STRIDE_A];
shared float shared_b[BK * SHMEM_STRIDE_B];

// ============================================================================
// Dequantization helpers
// ============================================================================

#include "dequant_kquants_tiled.glsl"

// Dequantize Q4_K element at [n_idx, k_idx]
float dequantize_q4_k(uint n_idx, uint k_idx, uint num_blocks) {
    uint block_idx = k_idx / QK4_K;
    uint elem_in_block = k_idx % QK4_K;
    uint block_byte = n_idx * num_blocks * QK4_K_BYTES + block_idx * QK4_K_BYTES;

    return dequantize_q4k_elem(block_byte, elem_in_block);
}

// ============================================================================
// Main kernel
// ============================================================================

void main() {
    uint lane_id = gl_LocalInvocationID.x;
    uint warp_id = gl_LocalInvocationID.y;
    uint tid = lane_id + warp_id * WARP_SIZE;

    uint wg_m = gl_WorkGroupID.y * BM;
    uint wg_n = gl_WorkGroupID.x * BN;
    uint batch = gl_WorkGroupID.z;

    if (wg_m >= op_m || wg_n >= op_n) {
        return;
    }

    uint thread_m, thread_n, warp_m_base, warp_n_base;
    compute_tile_coords(warp_id, lane_id, wg_m, wg_n, thread_m, thread_n, warp_m_base, warp_n_base);

    uint threads_per_warp = (WM * WN) / (TM * TN);
    bool is_active = lane_id < threads_per_warp;

    float acc[TM * TN];
    for (uint i = 0; i < TM * TN; i++) {
        acc[i] = 0.0;
    }

    uint a_offset = op_a_offset + batch * op_a_stride_b;
    uint num_blocks = (op_k + QK4_K - 1) / QK4_K;

    uint num_k_tiles = (op_k + BK - 1) / BK;

    for (uint k_tile = 0; k_tile < num_k_tiles; k_tile++) {
        uint k_base = k_tile * BK;
        uint k_tile_size = min(BK, op_k - k_base);

        // Cooperative load A tile
        for (uint i = tid; i < BM * BK; i += THREADS_PER_WG) {
            uint tile_m = i / BK;
            uint tile_k = i % BK;
            uint global_m = wg_m + tile_m;
            uint global_k = k_base + tile_k;

            float val = 0.0;
            if (global_m < op_m && global_k < op_k) {
                uint a_idx = a_offset + global_m * op_a_stride_m + global_k * op_a_stride_k;
                val = v_input_a[a_idx];
            }

            shared_a[tile_m * SHMEM_STRIDE_A + tile_k] = val;
        }

        // Cooperative load & dequantize B tile
        for (uint i = tid; i < BK * BN; i += THREADS_PER_WG) {
            uint tile_k = i / BN;
            uint tile_n = i % BN;
            uint global_n = wg_n + tile_n;
            uint global_k = k_base + tile_k;

            float val = 0.0;
            if (global_n < op_n && global_k < op_k) {
                val = dequantize_q4_k(global_n, global_k, num_blocks);
            }

            shared_b[tile_k * SHMEM_STRIDE_B + tile_n] = val;
        }

        barrier();

        // Compute
        if (is_active) {
            for (uint k_local = 0; k_local < k_tile_size; k_local++) {
                float a_frag[TM];
                for (uint tm = 0; tm < TM; tm++) {
                    uint a_row = (thread_m - wg_m) + tm;
                    a_frag[tm] = shared_a[a_row * SHMEM_STRIDE_A + k_local];
                }

                float b_frag[TN];
                for (uint tn = 0; tn < TN; tn++) {
                    uint b_col = (thread_n - wg_n) + tn;
                    b_frag[tn] = shared_b[k_local * SHMEM_STRIDE_B + b_col];
                }

                for (uint tm = 0; tm < TM; tm++) {
                    for (uint tn = 0; tn < TN; tn++) {
                        acc[tm * TN + tn] = fma(a_frag[tm], b_frag[tn], acc[tm * TN + tn]);
                    }
                }
            }
        }

        barrier();
    }

    // Write results
    if (is_active) {
        for (uint tm = 0; tm < TM; tm++) {
            for (uint tn = 0; tn < TN; tn++) {
                uint out_m = thread_m + tm;
                uint out_n = thread_n + tn;

                if (out_m < op_m && out_n < op_n) {
                    uint out_idx = batch * op_m * op_n + out_m * op_n + out_n;
                    v_dest[out_idx] = acc[tm * TN + tn];
                }
            }
        }
    }
}
