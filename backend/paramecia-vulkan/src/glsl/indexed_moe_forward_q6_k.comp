// Indexed MoE Forward - Q6_K Quantized Expert Matmul
//
// Computes: output[batch, topk, n] = weights[expert_id, n, k] @ x[batch, j, k]
// Where expert_id = ids[batch, topk]
//
// Adapted from matmul_q6_k.comp with expert indirection layer.

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q6_K constants
#define QK6_K 256        // Elements per Q6_K block
#define QK6_K_BYTES 210  // Bytes per block
#define QL_OFFSET 0
#define QL_SIZE 128
#define QH_OFFSET 128
#define QH_SIZE 64
#define SCALES_OFFSET 192
#define SCALES_SIZE 16
#define D_OFFSET 208

#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (36 bytes = 9 x u32)
layout(push_constant) uniform PushConstants {
    uint params[9];
    // [0]: n (out_dim)
    // [1]: k (in_dim)
    // [2]: batch
    // [3]: topk
    // [4]: x_inner_dim
    // [5]: expert_stride (u32 words per expert)
    // [6]: x_stride_batch
    // [7]: x_stride_inner
    // [8]: unused
};

#define op_n              params[0]
#define op_k              params[1]
#define op_batch          params[2]
#define op_topk           params[3]
#define op_x_inner_dim    params[4]
#define op_expert_stride  params[5]
#define op_x_stride_batch params[6]
#define op_x_stride_inner params[7]

layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

layout(set = 0, binding = 1, std430) readonly buffer InputX {
    float v_input_x[];
};

layout(set = 0, binding = 2, std430) readonly buffer WeightsBuf {
    uint v_input_b[];
};

layout(set = 0, binding = 3, std430) readonly buffer IdsBuf {
    uint v_ids[];
};

// ============================================================================
// Helper functions
// ============================================================================

float half_to_float_lo(uint packed) {
    return unpackHalf2x16(packed).x;
}

uint load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];
    return (word >> (byte_in_word * 8)) & 0xFF;
}

int load_i8(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];
    int val = int(word >> (byte_in_word * 8)) << 24 >> 24;
    return val;
}

uint load_u32(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    if (byte_in_word == 0) {
        return v_input_b[word_idx];
    } else {
        uint w0 = v_input_b[word_idx];
        uint w1 = v_input_b[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

float load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return unpackHalf2x16(word).y;
    } else {
        uint word2 = v_input_b[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

float warp_reduce_sum(float v) {
    v += subgroupShuffleXor(v, 16);
    v += subgroupShuffleXor(v, 8);
    v += subgroupShuffleXor(v, 4);
    v += subgroupShuffleXor(v, 2);
    v += subgroupShuffleXor(v, 1);
    return v;
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/4), batch, topk)

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint warp = gl_LocalInvocationID.y;
    uint wg_x = gl_WorkGroupID.x;
    uint batch_idx = gl_WorkGroupID.y;
    uint topk_idx = gl_WorkGroupID.z;

    uint out_col = wg_x * NWARPS + warp;

    if (out_col >= op_n || batch_idx >= op_batch || topk_idx >= op_topk) {
        return;
    }

    // Expert indirection
    uint expert_id = v_ids[batch_idx * op_topk + topk_idx];
    uint num_blocks = op_k / QK6_K;
    uint row_bytes = num_blocks * QK6_K_BYTES;
    uint expert_byte_offset = expert_id * op_expert_stride * 4;
    uint b_byte_offset = expert_byte_offset + out_col * row_bytes;

    // Input X pointer
    uint x_inner_idx = min(topk_idx, op_x_inner_dim - 1);
    uint x_offset = batch_idx * op_x_stride_batch + x_inner_idx * op_x_stride_inner;

    float acc = 0.0;

    for (uint blk = 0; blk < num_blocks; blk++) {
        uint block_byte = b_byte_offset + blk * QK6_K_BYTES;
        uint k_base = blk * QK6_K;

        float d = load_f16(block_byte + D_OFFSET);

        // Process 256 elements in 2 half-blocks of 128
        for (uint n = 0; n < 256; n += 128) {
            uint idx = n / 128;
            uint sc_base = block_byte + SCALES_OFFSET + 8 * idx;
            uint ql_base = block_byte + QL_OFFSET + 64 * idx;
            uint qh_base = block_byte + QH_OFFSET + 32 * idx;

            // Vectorized: load 8 scale bytes as 2 u32 words
            uint sc_w0 = load_u32(sc_base);
            uint sc_w1 = load_u32(sc_base + 4);

            // First pass: l = 0..15 (even-indexed scales: bytes 0, 2, 4, 6)
            {
                float scale0 = float(int(sc_w0 << 24) >> 24);        // byte 0
                float scale1 = float(int(sc_w0 << 8) >> 24);         // byte 2
                float scale2 = float(int(sc_w1 << 24) >> 24);        // byte 4
                float scale3 = float(int(sc_w1 << 8) >> 24);         // byte 6

                if (lane < 16) {
                    uint l = lane;
                    uint ql1 = load_byte(ql_base + l);
                    uint ql2 = load_byte(ql_base + l + 32);
                    uint qh1 = load_byte(qh_base + l);

                    int q1 = int((ql1 & 0xF) | ((qh1 & 3) << 4)) - 32;
                    int q2 = int((ql2 & 0xF) | (((qh1 >> 2) & 3) << 4)) - 32;
                    int q3 = int((ql1 >> 4) | (((qh1 >> 4) & 3) << 4)) - 32;
                    int q4 = int((ql2 >> 4) | (((qh1 >> 6) & 3) << 4)) - 32;

                    uint k0 = k_base + n + l;
                    uint k1 = k_base + n + l + 32;
                    uint k2 = k_base + n + l + 64;
                    uint k3 = k_base + n + l + 96;

                    float a0 = v_input_x[x_offset + k0];
                    float a1 = v_input_x[x_offset + k1];
                    float a2 = v_input_x[x_offset + k2];
                    float a3 = v_input_x[x_offset + k3];

                    acc += a0 * d * scale0 * float(q1);
                    acc += a1 * d * scale1 * float(q2);
                    acc += a2 * d * scale2 * float(q3);
                    acc += a3 * d * scale3 * float(q4);
                }
            }

            // Second pass: l = 16..31 (odd-indexed scales: bytes 1, 3, 5, 7)
            {
                float scale0 = float(int(sc_w0 << 16) >> 24);        // byte 1
                float scale1 = float(int(sc_w0) >> 24);              // byte 3
                float scale2 = float(int(sc_w1 << 16) >> 24);        // byte 5
                float scale3 = float(int(sc_w1) >> 24);              // byte 7

                if (lane < 16) {
                    uint l = lane + 16;
                    uint ql1 = load_byte(ql_base + l);
                    uint ql2 = load_byte(ql_base + l + 32);
                    uint qh1 = load_byte(qh_base + l);

                    int q1 = int((ql1 & 0xF) | ((qh1 & 3) << 4)) - 32;
                    int q2 = int((ql2 & 0xF) | (((qh1 >> 2) & 3) << 4)) - 32;
                    int q3 = int((ql1 >> 4) | (((qh1 >> 4) & 3) << 4)) - 32;
                    int q4 = int((ql2 >> 4) | (((qh1 >> 6) & 3) << 4)) - 32;

                    uint k0 = k_base + n + l;
                    uint k1 = k_base + n + l + 32;
                    uint k2 = k_base + n + l + 64;
                    uint k3 = k_base + n + l + 96;

                    float a0 = v_input_x[x_offset + k0];
                    float a1 = v_input_x[x_offset + k1];
                    float a2 = v_input_x[x_offset + k2];
                    float a3 = v_input_x[x_offset + k3];

                    acc += a0 * d * scale0 * float(q1);
                    acc += a1 * d * scale1 * float(q2);
                    acc += a2 * d * scale2 * float(q3);
                    acc += a3 * d * scale3 * float(q4);
                }
            }
        }
    }

    float sum = warp_reduce_sum(acc);

    if (lane == 0) {
        uint out_idx = batch_idx * op_topk * op_n + topk_idx * op_n + out_col;
        v_dest[out_idx] = sum;
    }
}
