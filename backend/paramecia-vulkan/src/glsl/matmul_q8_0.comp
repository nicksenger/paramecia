// Q8_0 Quantized Matrix Multiplication - GLSL/SPIR-V version
//
// Computes: C[m,n] = A[m,k] * B[n,k]^T
// Where B is Q8_0 quantized, stored row-major (each row is one output column)
//
// Optimizations:
// - Warp-level reductions using subgroupAdd (eliminates shared memory barriers)
// - Cooperative loading via subgroup shuffles
// - Packed integer operations for efficient i8 processing
// - Register-based accumulation to avoid bank conflicts
//
// Compile with:
//   glslc -fshader-stage=compute -O matmul_q8_0.comp -o matmul_q8_0_m1.spv
//
// For different configs, use defines:
//   -DM_TILE=1 for vector-matrix multiply (most common in LLM inference)
//   -DM_TILE=4 for small batch matrix multiply

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q8_0 constants
#define QK8_0 32        // Elements per Q8_0 block
#define QK8_0_BYTES 34  // 2 bytes f16 scale + 32 bytes i8

// Workgroup: 32 threads x 4 warps = 128 threads
// Each warp processes one output column, cooperatively across K
// 4 warps = 4 output columns per workgroup
#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (32 bytes)
layout(push_constant) uniform PushConstants {
    uint params[8];
    // [0]: m (rows of output)
    // [1]: k (reduction dimension)
    // [2]: n (columns of output)
    // [3]: a_stride_batch
    // [4]: a_offset
    // [5]: a_stride_k
    // [6]: a_stride_m
    // [7]: unused
};

#define op_m          params[0]
#define op_k          params[1]
#define op_n          params[2]
#define op_a_stride_b params[3]
#define op_a_offset   params[4]
#define op_a_stride_k params[5]
#define op_a_stride_m params[6]

// Output buffer (f32)
layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

// Input A buffer (f32) - the activations
layout(set = 0, binding = 1, std430) readonly buffer InputA {
    float v_input_a[];
};

// Input B buffer (Q8_0) - the quantized weights
// Stored as packed u32 for efficient access
// Each Q8_0 block: 2 bytes f16 + 32 bytes i8 = 34 bytes
layout(set = 0, binding = 2, std430) readonly buffer InputB {
    uint v_input_b[];
};

// Shared memory for warp-level reduction results
shared float warp_results[NWARPS];

// ============================================================================
// Helper functions
// ============================================================================

// Convert packed f16 to f32 (using the low 16 bits)
float half_to_float_lo(uint packed) {
    return unpackHalf2x16(packed).x;
}

// Load f16 scale from Q8_0 block given byte offset
// Q8_0 layout: [f16 scale (2 bytes)][i8 qs[32] (32 bytes)]
float load_q8_scale(uint block_byte) {
    // Block starts at block_byte, scale is first 2 bytes
    uint word_idx = block_byte / 4;
    uint byte_in_word = block_byte % 4;
    uint word = v_input_b[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_lo(word >> 16);
    } else {
        // Unaligned access - straddles two words
        uint word2 = v_input_b[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else { // byte_in_word == 3
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

// Load single i8 from Q8_0 block
int load_q8_i8(uint block_byte, uint qs_idx) {
    uint byte_offset = block_byte + 2 + qs_idx;  // +2 to skip scale
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];

    // Extract and sign-extend
    int val = int(word >> (byte_in_word * 8)) << 24 >> 24;
    return val;
}

// Load 4 consecutive i8 values as ivec4
ivec4 load_q8_4xi8(uint block_byte, uint qs_idx) {
    uint byte_offset = block_byte + 2 + qs_idx;
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;

    uint word = v_input_b[word_idx];
    ivec4 result;

    if (byte_in_word == 0) {
        // Aligned - all 4 bytes from one word
        result.x = int(word << 24) >> 24;
        result.y = int(word << 16) >> 24;
        result.z = int(word << 8) >> 24;
        result.w = int(word) >> 24;
    } else {
        // Unaligned - need two words
        uint word2 = v_input_b[word_idx + 1];

        if (byte_in_word == 1) {
            result.x = int(word << 16) >> 24;
            result.y = int(word << 8) >> 24;
            result.z = int(word) >> 24;
            result.w = int(word2 << 24) >> 24;
        } else if (byte_in_word == 2) {
            result.x = int(word << 8) >> 24;
            result.y = int(word) >> 24;
            result.z = int(word2 << 24) >> 24;
            result.w = int(word2 << 16) >> 24;
        } else { // byte_in_word == 3
            result.x = int(word) >> 24;
            result.y = int(word2 << 24) >> 24;
            result.z = int(word2 << 16) >> 24;
            result.w = int(word2 << 8) >> 24;
        }
    }
    return result;
}

// Warp-level sum reduction using subgroup operations
// Works correctly for 32-lane subgroups (NVIDIA, AMD)
float warp_reduce_sum(float v) {
    v += subgroupShuffleXor(v, 16);
    v += subgroupShuffleXor(v, 8);
    v += subgroupShuffleXor(v, 4);
    v += subgroupShuffleXor(v, 2);
    v += subgroupShuffleXor(v, 1);
    return v;
}

// ============================================================================
// Main kernel for M=1 (vector-matrix multiply)
// ============================================================================
// Each workgroup: 32 lanes x 4 warps = 128 threads
// Each warp handles one output column, all 32 lanes cooperate on the K reduction
// Dispatch: (ceil(n/4), 1, batch)

void main() {
    uint lane = gl_LocalInvocationID.x;      // 0-31
    uint warp = gl_LocalInvocationID.y;      // 0-3
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;            // Output row (m index)
    uint batch = gl_WorkGroupID.z;

    // Output column for this warp
    uint out_n = wg_x * NWARPS + warp;

    // Early exit if out of bounds
    if (out_n >= op_n) {
        return;
    }
    if (wg_y >= op_m) {
        return;
    }

    // Input A pointer for this row
    uint a_offset = op_a_offset + batch * op_a_stride_b + wg_y * op_a_stride_m;

    // Input B (Q8_0) pointer for this output column
    // Each row of B is one output column, stored contiguously
    uint num_blocks = op_k / QK8_0;
    uint b_row_bytes = num_blocks * QK8_0_BYTES;
    uint b_byte_offset = out_n * b_row_bytes;

    // Accumulator for this thread
    float acc = 0.0;

    // Process all Q8_0 blocks
    // Each block has 32 elements - one per lane in the warp
    for (uint blk = 0; blk < num_blocks; blk++) {
        uint block_byte = b_byte_offset + blk * QK8_0_BYTES;
        uint k_idx = blk * QK8_0 + lane;

        // Load scale (same for all lanes, but we let each load for simplicity)
        // The compiler/hardware should coalesce these
        float scale = load_q8_scale(block_byte);

        // Load quantized weight (one i8 per lane)
        int q = load_q8_i8(block_byte, lane);

        // Load activation value (one f32 per lane)
        float a = v_input_a[a_offset + k_idx * op_a_stride_k];

        // Compute partial product and accumulate
        acc += scale * a * float(q);
    }

    // Warp-level reduction using subgroup operations
    float sum = warp_reduce_sum(acc);

    // Lane 0 of each warp writes the result
    if (lane == 0) {
        uint out_idx = batch * op_m * op_n + wg_y * op_n + out_n;
        v_dest[out_idx] = sum;
    }
}
