// Q5_K Quantized Matrix Multiplication - GLSL/SPIR-V version
//
// Computes: C[m,n] = A[m,k] * B[n,k]^T
// Where B is Q5_K quantized (256 elements per block, 176 bytes)
//
// Q5_K block structure (176 bytes total):
// - Bytes 0-1: f16 d (scale)
// - Bytes 2-3: f16 dmin (minimum scale)
// - Bytes 4-15: u8 scales[12] (packed scale/min for 8 groups)
// - Bytes 16-47: u8 qh[32] (high bits for each element)
// - Bytes 48-175: u8 qs[128] (packed 4-bit low values)
//
// Each Q5_K block represents 256 elements in 8 groups of 32
// Each element is 5 bits: 4 bits from qs + 1 bit from qh
//
// Optimizations:
// - Warp-level reductions using subgroupAdd
// - Cooperative scale extraction via subgroup shuffles
// - Packed 5-bit extraction (4-bit base + 1-bit high)
// - Register-based accumulation

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q5_K constants
#define QK5_K 256        // Elements per Q5_K block
#define QK5_K_BYTES 176  // Bytes per block
#define D_OFFSET 0
#define DMIN_OFFSET 2
#define SCALES_OFFSET 4
#define QH_OFFSET 16
#define QS_OFFSET 48

// Workgroup: 32 threads x 4 warps = 128 threads
#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (32 bytes)
layout(push_constant) uniform PushConstants {
    uint params[8];
    // [0]: m (rows of output)
    // [1]: k (reduction dimension)
    // [2]: n (columns of output)
    // [3]: a_stride_batch
    // [4]: a_offset
    // [5]: a_stride_k
    // [6]: a_stride_m
    // [7]: unused
};

#define op_m          params[0]
#define op_k          params[1]
#define op_n          params[2]
#define op_a_stride_b params[3]
#define op_a_offset   params[4]
#define op_a_stride_k params[5]
#define op_a_stride_m params[6]

// Output buffer (f32)
layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

// Input A buffer (f32) - activations
layout(set = 0, binding = 1, std430) readonly buffer InputA {
    float v_input_a[];
};

// Input B buffer (Q5_K) - quantized weights
layout(set = 0, binding = 2, std430) readonly buffer InputB {
    uint v_input_b[];
};

// ============================================================================
// Helper functions
// ============================================================================

float half_to_float_lo(uint packed) {
    return unpackHalf2x16(packed).x;
}

float half_to_float_hi(uint packed) {
    return unpackHalf2x16(packed).y;
}

// Load a byte from the buffer given byte offset
uint load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];
    return (word >> (byte_in_word * 8)) & 0xFF;
}

// Load f16 from byte offset
float load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_hi(word);
    } else {
        uint word2 = v_input_b[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

// Warp-level sum reduction
float warp_reduce_sum(float v) {
    v += subgroupShuffleXor(v, 16);
    v += subgroupShuffleXor(v, 8);
    v += subgroupShuffleXor(v, 4);
    v += subgroupShuffleXor(v, 2);
    v += subgroupShuffleXor(v, 1);
    return v;
}

// ============================================================================
// Q5_K dequantization helpers
// ============================================================================

// Extract scale and minimum for a given sub-block (is = 0-7)
// Q5_K scales are encoded similarly to Q4_K
void get_q5k_scale_min(uint block_byte, uint is, out float d_scaled, out float m_scaled) {
    float d = load_f16(block_byte + D_OFFSET);
    float dmin = load_f16(block_byte + DMIN_OFFSET);

    uint sc_offset = block_byte + SCALES_OFFSET;
    uint b0 = load_byte(sc_offset + 0);
    uint b1 = load_byte(sc_offset + 1);
    uint b2 = load_byte(sc_offset + 2);
    uint b3 = load_byte(sc_offset + 3);
    uint b4 = load_byte(sc_offset + 4);
    uint b5 = load_byte(sc_offset + 5);
    uint b6 = load_byte(sc_offset + 6);
    uint b7 = load_byte(sc_offset + 7);
    uint b8 = load_byte(sc_offset + 8);
    uint b9 = load_byte(sc_offset + 9);
    uint b10 = load_byte(sc_offset + 10);
    uint b11 = load_byte(sc_offset + 11);

    // Same encoding as Q4_K
    uint sc, mn;
    if (is < 4) {
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_hi = uint[](b4, b5, b6, b7);
        sc = b_lo[is] & 0x3F;
        mn = b_hi[is] & 0x3F;
    } else {
        uint[4] b_hi2 = uint[](b8, b9, b10, b11);
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_mid = uint[](b4, b5, b6, b7);
        uint idx = is - 4;
        uint q_is4 = b_hi2[idx];
        uint q_is4n = b_lo[idx];
        uint q_is = b_mid[idx];
        sc = (q_is4 & 0xF) | (((q_is4n >> 6) & 0x3) << 4);
        mn = ((q_is4 >> 4) & 0xF) | (((q_is >> 6) & 0x3) << 4);
    }

    d_scaled = d * float(sc);
    m_scaled = dmin * float(mn);
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/NWARPS), m, batch)

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint warp = gl_LocalInvocationID.y;
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;

    // Output column for this warp
    uint out_n = wg_x * NWARPS + warp;
    uint out_m = wg_y;

    // Early exit if out of bounds
    if (out_n >= op_n || out_m >= op_m) {
        return;
    }

    // Input A pointer
    uint a_offset = op_a_offset + batch * op_a_stride_b + out_m * op_a_stride_m;

    // Input B (Q5_K) pointer
    uint num_blocks = op_k / QK5_K;
    uint b_row_bytes = num_blocks * QK5_K_BYTES;
    uint b_byte_offset = out_n * b_row_bytes;

    // Accumulator
    float acc = 0.0;

    // Process all Q5_K blocks
    for (uint blk = 0; blk < num_blocks; blk++) {
        uint block_byte = b_byte_offset + blk * QK5_K_BYTES;
        uint k_base = blk * QK5_K;

        // Q5_K has 256 elements per block, organized as 8 groups of 32
        // Each element: 4 bits from qs + 1 bit from qh = 5 bits total
        // qs layout: similar to Q4_K - 128 bytes with packed nibbles
        // qh layout: 32 bytes, one byte per 8 elements (8 bits per byte)

        // Process in groups of 64 (2 sub-blocks)
        for (uint j = 0; j < QK5_K; j += 64) {
            uint is = j / 32;  // Sub-block index (0-7)

            // Get scale and min for this sub-block pair
            float d1, m1, d2, m2;
            get_q5k_scale_min(block_byte, is, d1, m1);
            get_q5k_scale_min(block_byte, is + 1, d2, m2);

            // Process 64 elements with 32 lanes = 2 elements per lane
            uint qs_base = block_byte + QS_OFFSET + j / 2;

            if (lane < 32) {
                uint q_idx = lane;  // 0-31

                // Load packed nibble byte
                uint qs_byte = load_byte(qs_base + q_idx);
                uint q_lo = qs_byte & 0xF;
                uint q_hi = (qs_byte >> 4) & 0xF;

                // Load high bits from qh
                // qh[i] contains high bit for elements i, i+32, i+64, ..., i+224
                // For element j+q_idx: qh byte index = q_idx, bit = (j/32) % 8
                uint qh_byte_lo = load_byte(block_byte + QH_OFFSET + q_idx);
                uint qh_byte_hi = load_byte(block_byte + QH_OFFSET + q_idx);

                // Extract the right high bit for each element
                uint hm1 = 1u << (is % 8);
                uint hm2 = 1u << ((is + 1) % 8);
                uint h_lo = (qh_byte_lo & hm1) != 0 ? 16u : 0u;
                uint h_hi = (qh_byte_hi & hm2) != 0 ? 16u : 0u;

                // Full 5-bit values
                uint q5_lo = q_lo + h_lo;
                uint q5_hi = q_hi + h_hi;

                // Corresponding K indices
                uint k_lo = k_base + j + q_idx;
                uint k_hi = k_base + j + 32 + q_idx;

                // Load A values
                float a_lo = v_input_a[a_offset + k_lo * op_a_stride_k];
                float a_hi = v_input_a[a_offset + k_hi * op_a_stride_k];

                // Dequantize: val = d * q - m
                float v_lo = d1 * float(q5_lo) - m1;
                float v_hi = d2 * float(q5_hi) - m2;

                // Accumulate
                acc += a_lo * v_lo + a_hi * v_hi;
            }
        }
    }

    // Warp-level reduction
    float sum = warp_reduce_sum(acc);

    // Lane 0 writes result
    if (lane == 0) {
        uint out_idx = batch * op_m * op_n + out_m * op_n + out_n;
        v_dest[out_idx] = sum;
    }
}
