// Q4_K Quantized Matrix Multiplication - GLSL/SPIR-V version
//
// Computes: C[m,n] = A[m,k] * B[n,k]^T
// Where B is Q4_K quantized (256 elements per block, 144 bytes)
//
// Q4_K block structure (144 bytes total):
// - Bytes 0-1: f16 d (scale)
// - Bytes 2-3: f16 dmin (minimum scale)
// - Bytes 4-15: u8 scales[12] (packed scale/min values)
// - Bytes 16-143: u8 qs[128] (packed 4-bit quantized values)
//
// Each Q4_K block represents 256 elements in 8 groups of 32
//
// Optimizations:
// - Warp-level reductions using subgroupAdd
// - Cooperative scale extraction via subgroup shuffles
// - Packed nibble extraction
// - Register-based accumulation

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q4_K constants
#define QK4_K 256       // Elements per Q4_K block
#define QK4_K_BYTES 144 // Bytes per block
#define SCALES_OFFSET 4
#define QS_OFFSET 16

// Workgroup: 32 threads x 4 warps = 128 threads
#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (32 bytes)
layout(push_constant) uniform PushConstants {
    uint params[8];
    // [0]: m (rows of output)
    // [1]: k (reduction dimension)
    // [2]: n (columns of output)
    // [3]: a_stride_batch
    // [4]: a_offset
    // [5]: a_stride_k
    // [6]: a_stride_m
    // [7]: unused
};

#define op_m          params[0]
#define op_k          params[1]
#define op_n          params[2]
#define op_a_stride_b params[3]
#define op_a_offset   params[4]
#define op_a_stride_k params[5]
#define op_a_stride_m params[6]

// Output buffer (f32)
layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

// Input A buffer (f32) - activations
layout(set = 0, binding = 1, std430) readonly buffer InputA {
    float v_input_a[];
};

// Input B buffer (Q4_K) - quantized weights
layout(set = 0, binding = 2, std430) readonly buffer InputB {
    uint v_input_b[];
};

// ============================================================================
// Helper functions
// ============================================================================

float half_to_float_lo(uint packed) {
    return unpackHalf2x16(packed).x;
}

float half_to_float_hi(uint packed) {
    return unpackHalf2x16(packed).y;
}

// Load a byte from the buffer given byte offset
uint load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];
    return (word >> (byte_in_word * 8)) & 0xFF;
}

// Load u32 from byte offset (may be unaligned)
uint load_u32_unaligned(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;

    if (byte_in_word == 0) {
        return v_input_b[word_idx];
    } else {
        uint w0 = v_input_b[word_idx];
        uint w1 = v_input_b[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

// Load f16 from byte offset
float load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_hi(word);
    } else {
        uint word2 = v_input_b[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

// Warp-level sum reduction
float warp_reduce_sum(float v) {
    v += subgroupShuffleXor(v, 16);
    v += subgroupShuffleXor(v, 8);
    v += subgroupShuffleXor(v, 4);
    v += subgroupShuffleXor(v, 2);
    v += subgroupShuffleXor(v, 1);
    return v;
}

// ============================================================================
// Q4_K dequantization helpers
// ============================================================================

// Extract scale and minimum for a given sub-block (is = 0-7)
// Returns (d * scale, dmin * min_scale) pair
void get_q4k_scale_min(uint block_byte, uint is, out float d_scaled, out float m_scaled) {
    // Load header values
    float d = load_f16(block_byte);
    float dmin = load_f16(block_byte + 2);

    // Load scale bytes
    uint sc_offset = block_byte + SCALES_OFFSET;
    uint b0 = load_byte(sc_offset + 0);
    uint b1 = load_byte(sc_offset + 1);
    uint b2 = load_byte(sc_offset + 2);
    uint b3 = load_byte(sc_offset + 3);
    uint b4 = load_byte(sc_offset + 4);
    uint b5 = load_byte(sc_offset + 5);
    uint b6 = load_byte(sc_offset + 6);
    uint b7 = load_byte(sc_offset + 7);
    uint b8 = load_byte(sc_offset + 8);
    uint b9 = load_byte(sc_offset + 9);
    uint b10 = load_byte(sc_offset + 10);
    uint b11 = load_byte(sc_offset + 11);

    // Decode scales and mins according to Q4_K format
    uint sc, mn;
    if (is < 4) {
        // For is = 0-3: sc = b[is] & 0x3F, mn = b[is+4] & 0x3F
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_hi = uint[](b4, b5, b6, b7);
        sc = b_lo[is] & 0x3F;
        mn = b_hi[is] & 0x3F;
    } else {
        // For is = 4-7: complex encoding with bits from multiple bytes
        uint[4] b_hi2 = uint[](b8, b9, b10, b11);
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_mid = uint[](b4, b5, b6, b7);
        uint idx = is - 4;
        uint q_is4 = b_hi2[idx];
        uint q_is4n = b_lo[idx];
        uint q_is = b_mid[idx];
        sc = (q_is4 & 0xF) | (((q_is4n >> 6) & 0x3) << 4);
        mn = ((q_is4 >> 4) & 0xF) | (((q_is >> 6) & 0x3) << 4);
    }

    d_scaled = d * float(sc);
    m_scaled = dmin * float(mn);
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/NWARPS), m, batch)

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint warp = gl_LocalInvocationID.y;
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;

    // Output column for this warp
    uint out_n = wg_x * NWARPS + warp;
    uint out_m = wg_y;

    // Early exit if out of bounds
    if (out_n >= op_n || out_m >= op_m) {
        return;
    }

    // Input A pointer
    uint a_offset = op_a_offset + batch * op_a_stride_b + out_m * op_a_stride_m;

    // Input B (Q4_K) pointer
    uint num_blocks = op_k / QK4_K;
    uint b_row_bytes = num_blocks * QK4_K_BYTES;
    uint b_byte_offset = out_n * b_row_bytes;

    // Accumulator
    float acc = 0.0;

    // Process all Q4_K blocks
    for (uint blk = 0; blk < num_blocks; blk++) {
        uint block_byte = b_byte_offset + blk * QK4_K_BYTES;
        uint k_base = blk * QK4_K;

        // Q4_K has 256 elements per block, organized as 8 groups of 32
        // Within each group of 32: first 32 are low nibbles, next 32 are high nibbles
        // Actually: elements 0-31 and 32-63 share qs bytes 0-31, etc.

        // Each lane in the warp handles different elements
        // With 32 lanes and 256 elements per block, each lane processes 8 elements
        // We process in groups of 64 (2 sub-blocks at a time)

        for (uint j = 0; j < QK4_K; j += 64) {
            uint is = j / 32;  // Sub-block index (0-7)

            // Get scale and min for this sub-block pair
            float d1, m1, d2, m2;
            get_q4k_scale_min(block_byte, is, d1, m1);
            get_q4k_scale_min(block_byte, is + 1, d2, m2);

            // Process elements in the sub-block
            // Each lane handles part of the 64 elements
            uint qs_base = block_byte + QS_OFFSET + j / 2;

            // Lane handles 2 elements (one from low nibble group, one from high)
            // Distribute 64 elements across 32 lanes = 2 elements per lane
            if (lane < 32) {
                uint q_idx = lane;  // 0-31

                // Load packed nibble byte
                uint qs_byte = load_byte(qs_base + q_idx);

                // Extract low and high nibbles
                uint q_lo = qs_byte & 0xF;
                uint q_hi = (qs_byte >> 4) & 0xF;

                // Corresponding K indices
                uint k_lo = k_base + j + q_idx;      // First 32 elements
                uint k_hi = k_base + j + 32 + q_idx; // Second 32 elements

                // Load A values
                float a_lo = v_input_a[a_offset + k_lo * op_a_stride_k];
                float a_hi = v_input_a[a_offset + k_hi * op_a_stride_k];

                // Dequantize: val = d * q - m
                float v_lo = d1 * float(q_lo) - m1;
                float v_hi = d2 * float(q_hi) - m2;

                // Accumulate
                acc += a_lo * v_lo + a_hi * v_hi;
            }
        }
    }

    // Warp-level reduction
    float sum = warp_reduce_sum(acc);

    // Lane 0 writes result
    if (lane == 0) {
        uint out_idx = batch * op_m * op_n + out_m * op_n + out_n;
        v_dest[out_idx] = sum;
    }
}
