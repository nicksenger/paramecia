// QuZO Q3K perturbation / restore+update kernel
//
// Q3K block: [hmask[32] (32)][qs[64] (64)][scales[12] (12)][half d (2)] = 110 bytes
// 110 bytes is NOT 4-byte aligned, so process 2 blocks per workgroup:
// 2 * 110 = 220 bytes = 55 u32 words
// 128 threads: 64 per sub-block, each handles 4 elements
//
// Compile with: -DMODE_PERTURB=1 or -DMODE_RESTORE_UPDATE=1

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer DataBuf { uint data_buf[]; };
layout(set = 0, binding = 1) buffer PerturbBuf { float perturbation[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    float param1;
    float param2;
    uint seed1_lo;
    uint seed1_hi;
    uint seed2_lo;
    uint seed2_hi;
    uint flags;
};

shared uint s_data[55]; // 2 blocks = 220 bytes = 55 words

#include "quzo_common.comp"

void main() {
    uint wg = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint sub_block = tid >> 6; // 0 or 1
    uint sub_tid = tid & 63u;
    uint block_idx = wg * 2u + sub_block;

    // Load 2 blocks into shared memory
    uint global_word_base = wg * 55u;
    if (tid < 55u) {
        s_data[tid] = data_buf[global_word_base + tid];
    }
    barrier();

    if (block_idx >= count) return;

    // Block layout offsets (bytes within sub-block)
    uint block_byte = sub_block * 110u;
    uint hmask_byte = block_byte;         // 0-31
    uint qs_byte    = block_byte + 32u;   // 32-95
    uint scales_byte = block_byte + 96u;  // 96-107
    uint d_byte     = block_byte + 108u;  // 108-109

    // Read scale d
    float d = read_f16_shared(d_byte);
    if (abs(d) < 1e-10) return;

    // Thread mapping for Q3K (same as CUDA)
    uint r = sub_tid / 4u;
    uint tid_mod = sub_tid & 3u;
    uint is0 = r & 1u;        // r % 2
    uint l0 = 16u * is0 + 4u * tid_mod;
    uint n2 = r >> 2;         // r / 4
    uint j = (r >> 1) - 2u * n2;  // (r/2) - 2*(r/4)

    uint m = 1u << (4u * n2 + j);   // hmask bit position
    uint is_idx = 8u * n2 + 2u * j + is0;
    uint shift = 2u * j;            // bit shift in qs byte

    float dl = d * get_q3k_scale(scales_byte, is_idx);

    uint global_base = block_idx * 256u;
    uint64_t seed = (uint64_t(seed1_hi) << 32) | uint64_t(seed1_lo);
#ifndef MODE_PERTURB
    uint64_t update_seed = (uint64_t(seed2_hi) << 32) | uint64_t(seed2_lo);
#endif

    // Process 4 elements
    for (uint e = 0u; e < 4u; e++) {
        uint l = l0 + e;
        uint global_elem = global_base + 128u * n2 + l;

        // Extract low 2 bits from qs
        uint qs_off = qs_byte + 32u * n2 + l;
        uint qs_w = qs_off >> 2;
        uint qs_bp = qs_off & 3u;
        uint qs_packed = (s_data[qs_w] >> (qs_bp * 8u)) & 0xFFu;
        uint q2_val = (qs_packed >> shift) & 3u;

        // Extract high bit from hmask
        uint hm_off = hmask_byte + l;
        uint hm_w = hm_off >> 2;
        uint hm_bp = hm_off & 3u;
        uint hm_byte_val = (s_data[hm_w] >> (hm_bp * 8u)) & 0xFFu;
        bool hbit = (hm_byte_val & m) != 0u;

        // Reconstruct 3-bit signed value: if hbit set, q3 = q2; else q3 = q2 - 4
        int q3_val = hbit ? int(q2_val) : (int(q2_val) - 4);

        // Dequantize
        float val = dl * float(q3_val);

        float perturb = perturbation[global_elem];

#ifdef MODE_PERTURB
        float sign_f = ((flags & 1u) != 0u) ? 1.0 : -1.0;
        val += sign_f * param1 * perturb;
        uint64_t rng = init_rng(seed, global_elem);
#else
        val += param1 * perturb;
        val -= param2 * perturb;
        uint64_t rng = init_rng(update_seed, global_elem);
#endif

        // Re-quantize to i3 [-4, 3]
        float q_float = abs(dl) > 1e-10 ? val / dl : 0.0;
        int new_q3 = stochastic_round_i3(q_float, rng);

        // Reconstruct: q2_new = (q3_new >= 0) ? q3_new : q3_new + 4
        uint new_q2 = (new_q3 >= 0) ? uint(new_q3) : uint(new_q3 + 4);
        bool new_hbit = (new_q3 >= 0);

        // Update qs: clear old 2 bits at shift, set new
        uint old_qs = (s_data[qs_w] >> (qs_bp * 8u)) & 0xFFu;
        old_qs = (old_qs & ~(3u << shift)) | (new_q2 << shift);
        write_byte_shared(qs_w, qs_bp, old_qs);

        // Update hmask bit
        uint old_hm = (s_data[hm_w] >> (hm_bp * 8u)) & 0xFFu;
        if (new_hbit) {
            old_hm |= m;
        } else {
            old_hm &= ~m;
        }
        write_byte_shared(hm_w, hm_bp, old_hm);
    }

    barrier();

    if (tid < 55u) {
        data_buf[global_word_base + tid] = s_data[tid];
    }
}
