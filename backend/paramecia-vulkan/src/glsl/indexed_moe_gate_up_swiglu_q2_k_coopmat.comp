// Q2_K Indexed MoE Gate+Up+SwiGLU - Cooperative Matrix
// Computes: output[batch, topk, n] = silu(gate @ x) * (up @ x)
// Each workgroup processes TILE_N output columns for a single input vector (M=1)
#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#define Q2_K_K 256
#define Q2_K_K_BYTES 84

layout(constant_id = 0) const uint TILE_M = 16;
layout(constant_id = 1) const uint TILE_N = 16;
layout(constant_id = 2) const uint TILE_K = 16;

layout(local_size_x = 32) in;

layout(push_constant) uniform PushConstants { uint params[12]; };
#define op_n                  params[0]
#define op_k                  params[1]
#define op_batch              params[2]
#define op_topk               params[3]
#define op_x_inner_dim        params[4]
#define op_gate_expert_stride params[5]
#define op_up_expert_stride   params[6]
#define op_x_stride_batch     params[7]
#define op_x_stride_inner     params[8]
// params[9-11]: unused

layout(set = 0, binding = 0, std430) writeonly buffer O { float v_dest[]; };
layout(set = 0, binding = 1, std430) readonly buffer X { float x[]; };
layout(set = 0, binding = 2, std430) readonly buffer GateW { uint gate_weights[]; };
layout(set = 0, binding = 3, std430) readonly buffer UpW { uint up_weights[]; };
layout(set = 0, binding = 4, std430) readonly buffer I { uint ids[]; };

// Padded shared memory to avoid bank conflicts (16 -> 17)
shared float16_t shared_a[16 * 33];  // TILE_M * (TILE_K+1) where TILE_K can be 32
shared float16_t shared_b_gate[32 * 17];  // TILE_K * (TILE_N+1)
shared float16_t shared_b_up[32 * 17];  // TILE_K * (TILE_N+1)
shared float temp_c[16 * 16];  // TILE_M * TILE_N for storing matC results

float half_to_float_lo(uint packed) { return unpackHalf2x16(packed).x; }
float half_to_float_hi(uint packed) { return unpackHalf2x16(packed).y; }

uint load_byte_gate(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = gate_weights[word_idx];
    return (word >> (byte_in_word * 8)) & 0xFF;
}

uint load_byte_up(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = up_weights[word_idx];
    return (word >> (byte_in_word * 8)) & 0xFF;
}

float load_f16_gate(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = gate_weights[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_hi(word);
    } else {
        uint word2 = gate_weights[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

float load_f16_up(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = up_weights[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_hi(word);
    } else {
        uint word2 = up_weights[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_n = gl_WorkGroupID.x;          // Column tile
    uint batch_idx = gl_WorkGroupID.y;     // Batch index
    uint topk_idx = gl_WorkGroupID.z;      // Topk index

    if (wg_n >= (op_n + TILE_N - 1) / TILE_N || batch_idx >= op_batch || topk_idx >= op_topk) return;

    uint n_start = wg_n * TILE_N;

    uint expert_id = ids[batch_idx * op_topk + topk_idx];
    uint gate_expert_base = expert_id * op_gate_expert_stride * 4;  // Convert u32 words to bytes
    uint up_expert_base = expert_id * op_up_expert_stride * 4;      // Convert u32 words to bytes

    coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseA> matA;
    coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseB> matB_gate;
    coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseB> matB_up;
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC_gate;
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC_up;

    uint x_inner_idx = min(topk_idx, op_x_inner_dim - 1);
    uint x_base_offset = batch_idx * op_x_stride_batch + x_inner_idx * op_x_stride_inner;
    matC_gate = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(0.0);
    matC_up = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(0.0);

    // Single loop - dequantize both gate and up, reuse input x
    for (uint k_tile = 0; k_tile < (op_k + TILE_K - 1) / TILE_K; k_tile++) {
        uint k_start = k_tile * TILE_K;

        // Load input vector once (1×K): replicate across all M rows
        for (uint i = tid; i < TILE_M * TILE_K; i += 32) {
            uint m_local = i / TILE_K;
            uint k_local = i % TILE_K;
            uint k_idx = k_start + k_local;
            float val = 0.0;
            if (k_idx < op_k) {
                val = x[x_base_offset + k_idx];
            }
            shared_a[m_local * 17 + k_local] = float16_t(val);
        }

        // Dequantize BOTH gate and up weights in parallel
        // Q2K format (84 bytes per block):
        // - scales: 16 bytes at offset 0 (each byte: lower 4 bits = scale, upper 4 bits = min)
        // - qs: 64 bytes at offset 16 (2-bit values, 4 per byte)
        // - d: f16 at offset 80
        // - dmin: f16 at offset 82
        // Formula: value = d * scale * q - dmin * min
        for (uint i = tid; i < TILE_K * TILE_N; i += 32) {
            uint k_local = i / TILE_N;
            uint n_local = i % TILE_N;
            uint k_idx = k_start + k_local;
            uint n_idx = n_start + n_local;

            float gate_val = 0.0;
            float up_val = 0.0;

            if (k_idx < op_k && n_idx < op_n) {
                uint blk = k_idx / Q2_K_K;
                uint off = k_idx % Q2_K_K;
                uint num_blocks = (op_k + Q2_K_K - 1) / Q2_K_K;

                // Determine position within block (computed once, used twice)
                uint chunk = off / 128;
                uint off_in_chunk = off % 128;
                uint group32 = off_in_chunk / 32;
                uint subgroup = (off % 32) / 16;
                uint lane = off % 16;
                uint shift = group32 * 2;
                uint qs_index_base = chunk * 32;
                uint qs_byte_index = qs_index_base + (subgroup * 16) + lane;
                uint is = chunk * 8 + group32 * 2 + subgroup;

                // Dequantize gate weights
                {
                    uint block_byte = gate_expert_base + n_idx * num_blocks * Q2_K_K_BYTES + blk * Q2_K_K_BYTES;

                    // Load d and dmin
                    float d = load_f16_gate(block_byte + 80);
                    float dmin = load_f16_gate(block_byte + 82);

                    // Load scale byte
                    uint sc = load_byte_gate(block_byte + 0 + is);
                    float dl = d * float(sc & 0xF);
                    float ml = dmin * float(sc >> 4);

                    // Load and extract quantized value
                    uint qs_byte = load_byte_gate(block_byte + 16 + qs_byte_index);
                    uint q = (qs_byte >> shift) & 3u;

                    // Dequantize
                    gate_val = dl * float(q) - ml;
                }

                // Dequantize up weights
                {
                    uint block_byte = up_expert_base + n_idx * num_blocks * Q2_K_K_BYTES + blk * Q2_K_K_BYTES;

                    // Load d and dmin
                    float d = load_f16_up(block_byte + 80);
                    float dmin = load_f16_up(block_byte + 82);

                    // Load scale byte
                    uint sc = load_byte_up(block_byte + 0 + is);
                    float dl = d * float(sc & 0xF);
                    float ml = dmin * float(sc >> 4);

                    // Load and extract quantized value
                    uint qs_byte = load_byte_up(block_byte + 16 + qs_byte_index);
                    uint q = (qs_byte >> shift) & 3u;

                    // Dequantize
                    up_val = dl * float(q) - ml;
                }
            }

            shared_b_gate[k_local * 17 + n_local] = float16_t(gate_val);
            shared_b_up[k_local * 17 + n_local] = float16_t(up_val);
        }

        subgroupBarrier();
        coopMatLoad(matA, shared_a, 0, 17, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matB_gate, shared_b_gate, 0, 17, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matB_up, shared_b_up, 0, 17, gl_CooperativeMatrixLayoutRowMajor);
        matC_gate = coopMatMulAdd(matA, matB_gate, matC_gate);
        matC_up = coopMatMulAdd(matA, matB_up, matC_up);
        subgroupBarrier();
    }

    // Store gate results (only first row is valid)
    coopMatStore(matC_gate, temp_c, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
    subgroupBarrier();

    // Read gate results from temp_c (first row) before computing up
    float gate_val = 0.0;
    if (tid < TILE_N) {
        gate_val = temp_c[tid];
    }

    // Compute up matmul result and store in temp_c (overwrites gate)
    coopMatStore(matC_up, temp_c, 0, TILE_N, gl_CooperativeMatrixLayoutRowMajor);
    subgroupBarrier();

    // Apply SwiGLU and write output
    if (tid < TILE_N) {
        uint n_idx = n_start + tid;
        if (n_idx < op_n) {
            float up_val = temp_c[tid];
            float silu_gate = gate_val / (1.0 + exp(-gate_val));
            uint out_idx = batch_idx * op_topk * op_n + topk_idx * op_n + n_idx;
            v_dest[out_idx] = silu_gate * up_val;
        }
    }
}
