// Q6_K Matrix-Vector Multiplication - Warp-optimized for decode phase (m=1)
//
// Computes: out[n] = weights[n,k] * input[k]
// Where weights are Q6_K quantized (256 elements per block, 210 bytes each)
//
// Q6_K block structure (210 bytes):
// - Bytes 0-127: u8 ql[128] (low 4 bits of 6-bit quants)
// - Bytes 128-191: u8 qh[64] (high 2 bits of 6-bit quants)
// - Bytes 192-207: i8 scales[16] (8-bit scales for 16 groups)
// - Bytes 208-209: f16 d (super-block scale)
//
// Optimizations:
// - Warp-level reductions (subgroupShuffleXor) for fast reduction
// - Shared memory caching of 16 scales to avoid redundant loads
// - Vec2 dequantization to process 2 elements per iteration
// - Explicit FMA chaining for better instruction-level parallelism

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q6_K constants
#define QK6_K 256       // Elements per Q6_K block
#define QK6_K_BYTES 210 // Bytes per block
#define NUM_SCALES 16   // Number of scale groups per Q6_K block

// Workgroup: 32 threads x 4 warps = 128 threads
// Each warp processes 1 output element (4 outputs per workgroup)
#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Shared memory for caching scales per warp (avoids redundant loads)
shared float shared_scales[NWARPS][NUM_SCALES];

// Parameters via push constants (32 bytes)
layout(push_constant) uniform PushConstants {
    uint params[8];
};

#define op_m          params[0]
#define op_k          params[1]
#define op_n          params[2]
#define op_a_stride_b params[3]
#define op_a_offset   params[4]
#define op_a_stride_k params[5]
#define op_a_stride_m params[6]

layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

layout(set = 0, binding = 1, std430) readonly buffer InputA {
    float v_input_a[];
};

layout(set = 0, binding = 2, std430) readonly buffer InputB {
    uint v_input_b[];
};

// ============================================================================
// Helper functions
// ============================================================================

#include "dequant_helpers.glsl"

int load_signed_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];
    int val = int(word >> (byte_in_word * 8)) << 24 >> 24;
    return val;
}

float load_q6k_scale(uint block_byte) {
    uint scale_byte = block_byte + 208;
    uint word_idx = scale_byte / 4;
    uint byte_in_word = scale_byte % 4;
    uint word = v_input_b[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_lo(word >> 16);
    } else {
        uint word2 = v_input_b[word_idx + 1];
        uint h = (byte_in_word == 1)
            ? ((word >> 8) | (word2 << 24))
            : ((word >> 24) | (word2 << 8));
        return half_to_float_lo(h);
    }
}

// Load 6-bit quantized value using correct Q6K layout
int load_q6_value(uint block_byte, uint off) {
    uint j_base = (off < 128) ? 0 : 64;
    uint qh_base = j_base / 2;
    uint off_in_half = off % 128;
    uint quarter = off_in_half / 32;
    uint l = off_in_half % 32;

    uint ql_idx, qh_shift;
    bool use_upper_nibble;

    if (quarter == 0) {
        ql_idx = j_base + l;
        use_upper_nibble = false;
        qh_shift = 0;
    } else if (quarter == 1) {
        ql_idx = j_base + 32 + l;
        use_upper_nibble = false;
        qh_shift = 2;
    } else if (quarter == 2) {
        ql_idx = j_base + l;
        use_upper_nibble = true;
        qh_shift = 4;
    } else {
        ql_idx = j_base + 32 + l;
        use_upper_nibble = true;
        qh_shift = 6;
    }

    uint ql = load_byte(block_byte + ql_idx);
    uint qh = load_byte(block_byte + 128 + qh_base + l);

    uint ql_bits = use_upper_nibble ? (ql >> 4) : (ql & 0xF);
    uint qh_bits = (qh >> qh_shift) & 0x3;
    int q = int(ql_bits | (qh_bits << 4)) - 32;

    return q;
}

// Dequantize 2 consecutive Q6K elements at once
vec2 dequantize_q6_vec2(uint block_byte, uint elem_idx0, float d,
                        float cached_scales[NUM_SCALES]) {
    // Load two quantized values
    int q0 = load_q6_value(block_byte, elem_idx0);
    int q1 = load_q6_value(block_byte, elem_idx0 + 1);

    // Get scales from cached values (16 groups of 16 elements each)
    uint scale_idx0 = elem_idx0 / 16;
    uint scale_idx1 = (elem_idx0 + 1) / 16;

    float scale0 = cached_scales[scale_idx0];
    float scale1 = (scale_idx0 == scale_idx1) ? scale0 : cached_scales[scale_idx1];

    // Dequantize: weight = d * scale * q
    return vec2(
        d * scale0 * float(q0),
        d * scale1 * float(q1)
    );
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/4), batch, 1)
// Each workgroup processes 4 output elements (1 per warp)

void main() {
    uint lane = gl_LocalInvocationID.x;  // 0-31 within warp
    uint warp = gl_LocalInvocationID.y;  // 0-3 warp index
    uint out_n = gl_WorkGroupID.x * NWARPS + warp;
    uint batch = gl_WorkGroupID.y;

    if (out_n >= op_n) {
        return;
    }

    uint a_offset = op_a_offset + batch * op_a_stride_b;
    uint num_blocks = (op_k + QK6_K - 1) / QK6_K;
    uint weight_row_start = out_n * num_blocks * QK6_K_BYTES;

    float sum = 0.0;

    // Each Q6_K block has 256 elements, 16 groups of 16 elements
    // Distribute work: 32 threads process 256 elements (8 elements per thread)
    for (uint blk = 0; blk < num_blocks; blk++) {
        uint k_start = blk * QK6_K;
        uint block_byte = weight_row_start + blk * QK6_K_BYTES;

        float d = load_q6k_scale(block_byte);

        // Cache scales in shared memory: first 16 threads load all 16 scales
        if (lane < NUM_SCALES) {
            int scale_i8 = load_signed_byte(block_byte + 192 + lane);
            shared_scales[warp][lane] = float(scale_i8);
        }
        subgroupBarrier();

        // All threads read cached scales into registers
        float cached_scales[NUM_SCALES];
        for (uint s = 0; s < NUM_SCALES; s++) {
            cached_scales[s] = shared_scales[warp][s];
        }

        // Each thread processes 8 elements in 4 iterations of 2 elements each
        for (uint i = 0; i < 8; i += 2) {
            uint elem_idx0 = lane * 8 + i;  // 0-255
            uint k0 = k_start + elem_idx0;

            if (k0 + 1 < op_k) {
                // Dequantize 2 elements at once
                vec2 weights = dequantize_q6_vec2(block_byte, elem_idx0, d, cached_scales);

                // Load 2 activations
                uint a_idx0 = a_offset + k0 * op_a_stride_k;
                vec2 a_vals = vec2(
                    v_input_a[a_idx0],
                    v_input_a[a_idx0 + op_a_stride_k]
                );

                // Accumulate with explicit FMA
                sum = fma(weights.x, a_vals.x, sum);
                sum = fma(weights.y, a_vals.y, sum);
            } else if (k0 < op_k) {
                // Handle last element if odd number of elements
                int q = load_q6_value(block_byte, elem_idx0);
                uint scale_idx = elem_idx0 / 16;
                float weight = d * cached_scales[scale_idx] * float(q);
                uint a_idx = a_offset + k0 * op_a_stride_k;
                sum += weight * v_input_a[a_idx];
            }
        }
    }

    // Warp-level reduction (much faster than shared memory + barriers)
    sum = warp_reduce_sum(sum);

    // Lane 0 writes result
    if (lane == 0) {
        v_dest[batch * op_n + out_n] = sum;
    }
}
