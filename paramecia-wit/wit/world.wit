package paramecia:host@0.1.0;

/// Types shared between host and guest
interface types {
    /// Dedicated ID types — all backed by tuple<u64, u64> but semantically distinct.
    type model-id = tuple<u64, u64>;
    type checkpoint-id = tuple<u64, u64>;
    type snapshot-id = tuple<u64, u64>;
    type tool-call-id = tuple<u64, u64>;
    type sample-id = tuple<u64, u64>;

    /// A model actively loaded on the host
    record model {
        /// Unique identifier for the model generated by the host
        id: model-id,
        /// Number of experts in the model
        n-experts: u32,
        /// Number of layers in the model
        n-layers: u32
    }

    /// A saved model checkpoint
    record checkpoint {
        /// Unique identifier for the checkpoint generated by the host
        id: checkpoint-id,
    }

    /// Snapshot of a model's internal state
    record snapshot {
        /// Unique identifier for the snapshot generated by the host
        id: snapshot-id,
        state-position: u64,
        num-tokens: u32,
    }

    /// Persisted snapshot of a model's state
    record persisted-snapshot {
        /// Unique identifier for the snapshot generated by the host
        id: snapshot-id,
    }

    /// Model weights residing on disk
    variant weights {
        /// Weights provided via config/environment/argument to the host application
        host-default,
        /// Weights saved during controller execution
        checkpoint(checkpoint),
        /// Weights from a specific path
        path(string),
    }

    /// Weighted contribution of a member for task-arithmetic model fusion
    record fusion-member {
        /// Model weights
        weights: weights,
        /// The weighted contribution of this member
        contribution: f32,
    }

    /// Determines how to resolve a difference in quantization dtypes during model fusion
    variant quant-conflict-strategy {
        /// Reject the fusion, returning an error
        reject,
        /// Use the highest-precision dtype for any conflicting tensors
        highest,
        /// Use the lowest-precision dtype for any conflicting tensors
        lowest,
    }

    /// Per-layer expert indices for pruning.
    /// The outer list has one entry per MoE layer.
    /// Each inner list contains the expert indices to retain for that layer.
    record experts {
        indices: list<list<u32>>,
    }

    /// Weighted expert contributions for Shapley-based expert merging.
    /// Outer list: per MoE layer. Inner list: contribution weight per expert.
    record expert-contributions {
        weights: list<list<f32>>,
    }

    /// Request for expert pruning, bundling strategy with its required data
    variant expert-pruning-request {
        /// Drop pruned experts entirely
        naive(experts),
        /// Merge pruned expert knowledge back into retained experts,
        /// weighted by Shapley contribution values
        shapley-merge(expert-merge-spec),
    }

    /// Expert pruning via Shapley merging: retained indices paired with
    /// their contribution weights to ensure dimensional alignment.
    record expert-merge-spec {
        /// Expert indices to retain, per MoE layer
        retained: experts,
        /// Shapley contribution weights, per MoE layer per expert
        contributions: expert-contributions,
    }

    /// Layer indices for pruning
    record layers {
        indices: list<u32>
    }

    /// Identifies a specific layer within a model's weights.
    record layer-ref {
        /// The model weights containing this layer
        source: weights,
        /// Zero-based layer index within the model
        layer-idx: u32,
    }

    /// Identifies a specific expert within a model.
    record expert-ref {
        /// The layer containing this expert
        layer: layer-ref,
        /// Zero-based expert index within the layer
        expert-idx: u32,
    }

    /// Mapping of architectural elements for grafting.
    /// Each layer is independently sourced from a specific layer in a model.
    record model-composite {
        embedding: weights,
        layers: list<layer-ref>,
        lm-head: option<weights>,
        mtp-head: option<weights>,
    }

    /// A single logit entry: token ID + log probability
    record logit-entry {
        token-id: u32,
        log-prob: f32,
    }

    /// Result from a forward pass: sampled token + distribution info
    record predicted {
        /// The sampled token ID
        token-id: u32,
        /// Decoded text for the token (none if out of vocabulary)
        text: option<string>,
        /// Top-K entries sorted by probability descending
        top-k: list<logit-entry>,
        /// Stratified tail samples (near-miss + bottom-99% regions)
        tail: list<logit-entry>,
        /// Total probability mass of tokens outside top-k
        tail-mass: f32,
        /// Per-layer expert indices from MoE routing
        expert-indices: list<u32>,
    }

    /// Inputs provided for a model forward pass
    variant model-input {
        /// Text context (tokenized by the host)
        text(string),
        /// Specific token IDs
        tokens(list<u32>),
        /// Soft prompt: each entry is a weighted token in a single-position distribution.
        /// The host converts each logit-entry list element into one embedding position
        /// by computing a weighted sum over the token embedding table, producing a
        /// sequence of length equal to the list length.
        soft(list<logit-entry>),
        /// Raw probability vector for a single synthetic position.
        /// Length must exactly match the loaded model vocabulary size.
        raw(list<f32>),
    }

    /// A segment of training data: either masked context or teacher-labeled generation
    variant training-data {
        /// Non-generated text (masked during loss computation)
        context(model-input),
        /// Teacher model output — logits for generated tokens
        target(list<predicted>),
    }

    /// A complete training sample: interleaved context and generation segments
    /// with a unique identifier for tracking.
    record training-sample {
        /// Unique sample identifier (echoed back by the host for use for guest-side bookkeeping)
        id: sample-id,
        /// Interleaved context and generation segments
        data: list<training-data>,
    }

    /// A batch of training data for fine-grained training operations
    record training-batch {
        data: list<training-data>,
    }

    /// Result of a training step: loss and the IDs of all samples consumed.
    record step-result {
        loss: f64,
        sample-ids: list<sample-id>,
        n-tokens: u64
    }

    /// Zeroth-order optimization state: model perturbed with +epsilon.
    /// This type enforces the QuZO call sequence:
    ///   perturb-up → (evaluate loss+) → perturb-down → (evaluate loss-) → update
    /// The positive perturbation must be evaluated before proceeding to perturb-down.
    record positive-model {
        model: model
    }

    /// Zeroth-order optimization state: model perturbed with -epsilon.
    /// Created by perturb-down after recording the positive-direction loss.
    /// Must be evaluated and passed to update to complete the optimization step.
    record negative-model {
        model: model
    }

    /// Parameters for error feedback in quantized zeroth-order optimization.
    record error-feedback-params {
        /// Decay factor (gamma, 0-1)
        decay: f64,
        /// Gain (0 = pure stochastic, 1 = full feedback)
        gain: f64,
    }

    /// Error feedback mode for accumulated residuals in quantized zeroth-order optimization.
    variant error-feedback-mode {
        /// No error feedback
        %none,
        /// FP16 residuals stored per element
        persistent(error-feedback-params),
        /// Reconstruct residuals by replaying the last N steps
        replay(replay-params),
    }

    /// Parameters for replay-based error feedback.
    record replay-params {
        /// Number of steps to replay
        steps: u32,
        /// Decay factor (gamma, 0-1)
        decay: f64,
        /// Gain (0 = pure stochastic, 1 = full feedback)
        gain: f64,
    }

    /// Model component types for per-component epsilon multipliers.
    variant epsilon-component {
        /// Embedding layer (token_embd)
        embedding,
        /// Attention Q/K/V/O projections
        attention,
        /// MoE router/gating layers
        moe-gating,
        /// MoE expert layers
        moe-experts,
        /// MoE expert bank tensors (ffn_*_exps)
        moe-expert-banks,
        /// MTP (Multi-Token Prediction) heads
        mtp,
        /// Norm weights
        norms,
        /// SSM/linear-attention parameters
        ssm,
        /// Other layers (output, etc)
        other,
    }

    record hyper-parameter-update {
        mtp-decay: option<f64>,
        num-speculative: option<u8>,
        temperature: option<f64>,
        lb-loss: option<f64>,
        z-loss: option<f64>,
        clip-threshold: option<f64>,
        /// QuZO learning rate
        lr: option<f64>,
        /// QuZO perturbation magnitude (base epsilon)
        epsilon: option<f64>,
        /// Per-component epsilon multipliers (override base epsilon for specific component types)
        epsilon-multipliers: option<list<tuple<epsilon-component, f64>>>,
        /// Error feedback mode for quantized zeroth-order optimization
        error-feedback: option<error-feedback-mode>,
    }

    /// Description of a model's tensors and metadata
    record model-description {
        n-experts: u32,
        n-layers: u32,
        n-total-parameters: u64,
        n-active-parameters: u64,
        metadata: list<tuple<string, metadata-value>>,
        tensors: list<gguf-tensor>,
    }

    record gguf-tensor {
        name: string,
        shape: list<u32>,
        dtype: ggml-dtype,
    }

    variant metadata-value {
        %u8(u8),
        %s8(s8),
        %u16(u16),
        %s16(s16),
        %u32(u32),
        %s32(s32),
        %u64(u64),
        %s64(s64),
        %f32(f32),
        %f64(f64),
        %bool(bool),
        %string(string),
        /// Array of metadata values, JSON-encoded (WIT cannot express recursive types)
        array(string),
    }

    variant ggml-dtype {
        %f32,
        %f16,
        bf16,
        q40,
        q41,
        q50,
        q51,
        q80,
        q81,
        q2k,
        q3k,
        q4k,
        q5k,
        q6k,
        q8k,
    }

    /// A tool execution result sent from the UI back to the controller.
    record tool-exec-result {
        /// Tool call ID
        id: tool-call-id,
        /// Tool name
        name: string,
        /// Tool output content
        content: string,
    }

    /// A tool call emitted by the controller for the UI to execute.
    record tool-call-request {
        /// Unique identifier for this tool call
        id: tool-call-id,
        /// Name of the tool/function to call
        name: string,
        /// Parsed arguments as a JSON string
        arguments: string,
        /// Number of tokens that the tool-call is composed of
        n-tokens: u32,
    }

    /// Events received from the interface during interactive mode
    variant user-event {
        /// A request from the interface to prefill specific text
        prefill(string),
        /// A user-entered prompt
        prompt(string),
        /// A request to cancel the current operation
        cancel,
        /// A tool execution result
        tool-result(tool-exec-result),
        /// A request to compact the current context
        compaction,
    }

    /// A user-event wrapped in a result for stream error handling
    type user-event-item = result<user-event, error>;

    /// Events emitted from the controller to the interface during interactive mode
    variant agent-event {
        /// Indicates that the agent is ready
        initialized,
        /// Context token update (number of new tokens)
        context-tokens(u32),
        /// A text delta from the assistant corresponding to a single token
        token(string),
        /// A complete, parsed tool call ready for execution
        tool-call(tool-call-request),
        /// Generation is finished.
        done,
        /// Error which should be displayed to the user
        error(string),
    }

    variant error {
        not-available(string),
        train-error(string),
        checkpoint-error(string),
        invalid-state(string),
        model-error(string),
        tokenize-error(string),
        snapshot-error(string),
    }
}

/// Operations related to the management of model weights and state
interface structure {
    use types.{model, weights, checkpoint, error, model-description, metadata-value};

    /// Loads model into memory using the provided weights.
    load-model: async func(source: weights) -> result<model, error>;

    /// Unload the provided model, freeing memory.
    unload-model: async func(model: model) -> result<_, error>;

    /// Writes model into persistent storage.
    save-checkpoint: async func(model: model) -> result<checkpoint, error>;

    /// Delete a checkpoint from persistent storage.
    delete-checkpoint: async func(checkpoint: checkpoint) -> result<_, error>;

    /// Returns details about a GGUF model
    describe-model: async func(source: weights) -> result<model-description, error>;

    /// Updates a model's metadata
    update-metadata: async func(checkpoint: checkpoint, metadata: list<tuple<string, metadata-value>>) -> result<_, error>;
}

/// Functionality related to the direct modification of model weights or state
interface structure-ext {
    use types.{model, snapshot, persisted-snapshot,
               weights, expert-pruning-request, layers,
               model-composite, checkpoint, error, fusion-member,
               quant-conflict-strategy};

    /// Take an in-memory snapshot of the current model state.
    take-snapshot: async func(model: model) -> result<snapshot, error>;

    /// Write an in-memory snapshot to persistent storage.
    persist-snapshot: async func(handle: snapshot) -> result<persisted-snapshot, error>;

    /// Drop an in-memory snapshot, freeing its memory.
    drop-snapshot: func(snapshot: snapshot);

    /// Restore a model's internal state from an in-memory snapshot.
    /// The snapshot is not consumed and can be restored again.
    restore-snapshot: async func(model: model, snapshot: snapshot) -> result<_, error>;

    /// Load a persisted snapshot from disk into memory.
    load-snapshot: async func(model: model, snapshot: persisted-snapshot) -> result<snapshot, error>;

    /// Delete a persisted snapshot file from disk.
    delete-snapshot: async func(snapshot: persisted-snapshot) -> result<_, error>;

    /// Reseed the sampler RNG. Useful after restoring a snapshot to get
    /// varied generations from the same state.
    reseed: async func(seed: u64) -> result<_, error>;

    /// Prunes experts from a model, returning the new weights
    prune-experts: async func(source: weights, request: expert-pruning-request) -> result<checkpoint, error>;

    /// Prunes layers from a model, returning the new weights
    prune-layers: async func(source: weights, retained-layers: layers) -> result<checkpoint, error>;

    /// Constructs a new model based on the provided composite map
    graft: async func(composite: model-composite) -> result<checkpoint, error>;

    /// Fuse two or more models using task-arithmetic
    fuse: async func(base: weights, members: list<fusion-member>, strategy: quant-conflict-strategy) -> result<checkpoint, error>;
}

/// Host-driven inference functionality
interface inference {
    use types.{model, predicted, error, model-input};

    /// Fill the model context with the given inputs.
    /// Returns a stream of progress updates (number of tokens filled so far).
    /// Extends the existing context (does not reset).
    fill-context: func(model: model, input: list<model-input>) -> stream<result<u32, error>>;

    /// Generate a full completion by running the inference loop until EOS or
    /// <|im_end|> is encountered. Returns a stream of predictions. The host
    /// generates tokens at full speed, fire-and-forget streaming each to guest.
    predict-completion: func(model: model) -> stream<result<predicted, error>>;

    /// Cancel an ongoing predict-completion operation. Returns once the
    /// background task has fully stopped. The completion stream will end
    /// with a cancellation error. No effect if no completion is active.
    cancel-prediction: async func(model: model) -> result<_, error>;
}

/// Controller-driven inference functionality
/// Allows the guest-module to customize the inference process.
interface inference-ext {
    use types.{model, predicted, error, model-input};

    /// Generate full completions for all of the provided inputs. The host handles
    /// batching and padding for inputs of different length.
    /// Returns a stream of predictions for each sequence, padding output sequences
    /// which terminate with <|im_end|> or EOS prior to the longest sequence.
    predict-completions-batched: func(model: model, input: list<list<model-input>>) -> stream<result<list<predicted>, error>>;

    /// Run one forward pass, sample a token using host-configured parameters,
    /// and return the result. Must call commit-token before calling again.
    predict-token: async func(model: model) -> result<predicted, error>;

    /// Commit a token into the context. Must be called between
    /// predict-token calls.
    commit-token: func(model: model, token: u32) -> result<_, error>;
}

/// Host-driven training functionality
interface training {
    use types.{model, training-sample, step-result, hyper-parameter-update, error};

    /// Stream training samples to the host. Host auto-batches into minibatch steps.
    /// Each stream item is a complete sample (list<training-data> with interleaved
    /// context/generation segments). The host accumulates N samples (per minibatch_size)
    /// then runs one QuZO optimization step.
    /// Returns a stream of per-step results (loss + consumed sample IDs).
    train-model: func(model: model, data: stream<training-sample>) -> result<stream<result<step-result, error>>, error>;

    /// Validate the model (does not update the weights)
    validate-model: func(model: model, data: stream<training-sample>) -> result<stream<result<step-result, error>>, error>;

    /// Stops an active training process
    cancel-training: async func(model: model) -> result<_, error>;

    /// Set hyperparameters
    set-hyper-parameters: async func(model: model, update: hyper-parameter-update) -> result<_, error>;
}

/// Controller-driven zeroth-order (QuZO) training interface.
///
/// QuZO estimates gradients by evaluating loss at two perturbation points:
///   1. perturb-up: apply +epsilon perturbation → returns positive-model
///   2. Guest evaluates loss on positive-model (forward pass)
///   3. perturb-down: record loss+, apply -epsilon perturbation → returns negative-model
///   4. Guest evaluates loss on negative-model (forward pass)
///   5. update: record loss-, compute gradient estimate, update weights → returns model
interface training-ext {
    use types.{model, positive-model, negative-model, error};

    /// Begins a training step, perturbing the model in the positive direction
    perturb-up: async func(model: model) -> result<positive-model, error>;

    /// Restores a positively perturbed model, then perturbs it in the negative direction
    perturb-down: async func(perturbed: positive-model, loss-up: f32) -> result<negative-model, error>;

    /// Calculates the difference in loss and updates the weights
    update: async func(perturbed: negative-model, loss-down: f32) -> result<model, error>;
}

interface interactive {
    use types.{user-event-item, agent-event, error};

    /// Connects this controller to the user-interface (if available).
    /// The guest provides an outbound stream of agent-events and receives
    /// an inbound stream of user-events in return.
    connect: func(outputs: stream<agent-event>) -> result<stream<user-event-item>, error>;
}

/// The world that controller WASM components target
world controller {
    /// WASI 0.3 basics for async I/O
    include wasi:cli/imports@0.3.0-rc-2026-01-06;

    import structure;
    import structure-ext;
    import inference;
    import inference-ext;
    import training;
    import training-ext;
    import interactive;

    /// Guest entry point (async)
    export wasi:cli/run@0.3.0-rc-2026-01-06;
}
