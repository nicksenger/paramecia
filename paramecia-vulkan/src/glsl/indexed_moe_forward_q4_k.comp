// Indexed MoE Forward - Q4_K Quantized Expert Matmul
//
// Computes: output[batch, topk, n] = weights[expert_id, n, k] @ x[batch, j, k]
// Where expert_id = ids[batch, topk]
//
// Adapted from matmul_q4_k.comp with expert indirection layer.

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q4_K constants
#define QK4_K 256       // Elements per Q4_K block
#define QK4_K_BYTES 144 // Bytes per block
#define SCALES_OFFSET 4
#define QS_OFFSET 16

#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (36 bytes = 9 x u32)
layout(push_constant) uniform PushConstants {
    uint params[9];
    // [0]: n (out_dim)
    // [1]: k (in_dim)
    // [2]: batch
    // [3]: topk
    // [4]: x_inner_dim
    // [5]: expert_stride (u32 words per expert)
    // [6]: x_stride_batch
    // [7]: x_stride_inner
    // [8]: unused
};

#define op_n              params[0]
#define op_k              params[1]
#define op_batch          params[2]
#define op_topk           params[3]
#define op_x_inner_dim    params[4]
#define op_expert_stride  params[5]
#define op_x_stride_batch params[6]
#define op_x_stride_inner params[7]

layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

layout(set = 0, binding = 1, std430) readonly buffer InputX {
    float v_input_x[];
};

layout(set = 0, binding = 2, std430) readonly buffer WeightsBuf {
    uint v_input_b[];
};

layout(set = 0, binding = 3, std430) readonly buffer IdsBuf {
    uint v_ids[];
};

// ============================================================================
// Helper functions
// ============================================================================

float half_to_float_lo(uint packed) {
    return unpackHalf2x16(packed).x;
}

float half_to_float_hi(uint packed) {
    return unpackHalf2x16(packed).y;
}

uint load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];
    return (word >> (byte_in_word * 8)) & 0xFF;
}

uint load_u32(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    if (byte_in_word == 0) {
        return v_input_b[word_idx];
    } else {
        uint w0 = v_input_b[word_idx];
        uint w1 = v_input_b[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

float load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_input_b[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_hi(word);
    } else {
        uint word2 = v_input_b[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

float warp_reduce_sum(float v) {
    v += subgroupShuffleXor(v, 16);
    v += subgroupShuffleXor(v, 8);
    v += subgroupShuffleXor(v, 4);
    v += subgroupShuffleXor(v, 2);
    v += subgroupShuffleXor(v, 1);
    return v;
}

// Q4_K scale/min extraction
void get_q4k_scale_min(uint block_byte, uint is, out float d_scaled, out float m_scaled) {
    float d = load_f16(block_byte);
    float dmin = load_f16(block_byte + 2);

    uint sc_offset = block_byte + SCALES_OFFSET;
    // Vectorized: 3 u32 loads instead of 12 byte loads
    uint w0 = load_u32(sc_offset);
    uint w1 = load_u32(sc_offset + 4);
    uint w2 = load_u32(sc_offset + 8);
    uint b0 = w0 & 0xFF; uint b1 = (w0 >> 8) & 0xFF;
    uint b2 = (w0 >> 16) & 0xFF; uint b3 = (w0 >> 24) & 0xFF;
    uint b4 = w1 & 0xFF; uint b5 = (w1 >> 8) & 0xFF;
    uint b6 = (w1 >> 16) & 0xFF; uint b7 = (w1 >> 24) & 0xFF;
    uint b8 = w2 & 0xFF; uint b9 = (w2 >> 8) & 0xFF;
    uint b10 = (w2 >> 16) & 0xFF; uint b11 = (w2 >> 24) & 0xFF;

    uint sc, mn;
    if (is < 4) {
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_hi = uint[](b4, b5, b6, b7);
        sc = b_lo[is] & 0x3F;
        mn = b_hi[is] & 0x3F;
    } else {
        uint[4] b_hi2 = uint[](b8, b9, b10, b11);
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_mid = uint[](b4, b5, b6, b7);
        uint idx = is - 4;
        uint q_is4 = b_hi2[idx];
        uint q_is4n = b_lo[idx];
        uint q_is = b_mid[idx];
        sc = (q_is4 & 0xF) | (((q_is4n >> 6) & 0x3) << 4);
        mn = ((q_is4 >> 4) & 0xF) | (((q_is >> 6) & 0x3) << 4);
    }

    d_scaled = d * float(sc);
    m_scaled = dmin * float(mn);
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/4), batch, topk)

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint warp = gl_LocalInvocationID.y;
    uint wg_x = gl_WorkGroupID.x;
    uint batch_idx = gl_WorkGroupID.y;
    uint topk_idx = gl_WorkGroupID.z;

    uint out_col = wg_x * NWARPS + warp;

    if (out_col >= op_n || batch_idx >= op_batch || topk_idx >= op_topk) {
        return;
    }

    // Expert indirection
    uint expert_id = v_ids[batch_idx * op_topk + topk_idx];
    uint num_blocks = op_k / QK4_K;
    uint row_bytes = num_blocks * QK4_K_BYTES;
    uint expert_byte_offset = expert_id * op_expert_stride * 4;
    uint b_byte_offset = expert_byte_offset + out_col * row_bytes;

    // Input X pointer
    uint x_inner_idx = min(topk_idx, op_x_inner_dim - 1);
    uint x_offset = batch_idx * op_x_stride_batch + x_inner_idx * op_x_stride_inner;

    float acc = 0.0;

    for (uint blk = 0; blk < num_blocks; blk++) {
        uint block_byte = b_byte_offset + blk * QK4_K_BYTES;
        uint k_base = blk * QK4_K;

        for (uint j = 0; j < QK4_K; j += 64) {
            uint is = j / 32;

            float d1, m1, d2, m2;
            get_q4k_scale_min(block_byte, is, d1, m1);
            get_q4k_scale_min(block_byte, is + 1, d2, m2);

            uint qs_base = block_byte + QS_OFFSET + j / 2;

            if (lane < 32) {
                uint q_idx = lane;
                uint qs_byte = load_byte(qs_base + q_idx);
                uint q_lo = qs_byte & 0xF;
                uint q_hi = (qs_byte >> 4) & 0xF;

                uint k_lo = k_base + j + q_idx;
                uint k_hi = k_base + j + 32 + q_idx;

                float a_lo = v_input_x[x_offset + k_lo];
                float a_hi = v_input_x[x_offset + k_hi];

                float v_lo = d1 * float(q_lo) - m1;
                float v_hi = d2 * float(q_hi) - m2;

                acc += a_lo * v_lo + a_hi * v_hi;
            }
        }
    }

    float sum = warp_reduce_sum(acc);

    if (lane == 0) {
        uint out_idx = batch_idx * op_topk * op_n + topk_idx * op_n + out_col;
        v_dest[out_idx] = sum;
    }
}
