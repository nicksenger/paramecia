// Indexed MoE Forward - Q8_0 Quantized Expert Matmul (DP4A optimized)
//
// Computes: output[batch, topk, n] = weights[expert_id, n, k] @ x[batch, j, k]
// Where expert_id = ids[batch, topk], and j = topk_idx if x has topk dim, else 0
//
// Uses DP4A-style packed 4xi8 loads for improved throughput:
// - 8 lanes cooperate per output column (each loading 4 i8 values)
// - 4 columns per warp (COLS_PER_WARP = 4)
// - 16 output columns per workgroup (4 warps * 4 cols/warp)

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q8_0 constants
#define QK8_0 32        // Elements per Q8_0 block
#define QK8_0_BYTES 34  // 2 bytes f16 scale + 32 bytes i8

// Workgroup: 32 threads x 4 warps = 128 threads
// Each warp handles 4 output columns (8 lanes per column)
#define WARP_SIZE 32
#define NWARPS 4
#define COLS_PER_WARP 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (36 bytes = 9 x u32)
layout(push_constant) uniform PushConstants {
    uint params[9];
    // [0]: n (out_dim, output columns)
    // [1]: k (in_dim, reduction dimension)
    // [2]: batch
    // [3]: topk
    // [4]: x_inner_dim (topk if x is 3D with topk dim, else 1)
    // [5]: expert_stride (number of u32 words per expert)
    // [6]: x_stride_batch (stride in f32 elements between batches)
    // [7]: x_stride_inner (stride in f32 elements between inner dim entries)
    // [8]: unused
};

#define op_n              params[0]
#define op_k              params[1]
#define op_batch          params[2]
#define op_topk           params[3]
#define op_x_inner_dim    params[4]
#define op_expert_stride  params[5]
#define op_x_stride_batch params[6]
#define op_x_stride_inner params[7]

// Output buffer (f32)
layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

// Input X buffer (f32) - the activations
layout(set = 0, binding = 1, std430) readonly buffer InputX {
    float v_input_x[];
};

// Weights buffer (Q8_0) - all experts contiguous
layout(set = 0, binding = 2, std430) readonly buffer WeightsBuf {
    uint v_weights[];
};

// IDs buffer (u32) - expert indices [batch, topk]
layout(set = 0, binding = 3, std430) readonly buffer IdsBuf {
    uint v_ids[];
};

// ============================================================================
// Helper functions
// ============================================================================

float half_to_float_lo(uint packed) {
    return unpackHalf2x16(packed).x;
}

// Load f16 scale from Q8_0 block given byte offset
float load_q8_scale(uint block_byte) {
    uint word_idx = block_byte / 4;
    uint byte_in_word = block_byte % 4;
    uint word = v_weights[word_idx];

    if (byte_in_word == 0) {
        return half_to_float_lo(word);
    } else if (byte_in_word == 2) {
        return half_to_float_lo(word >> 16);
    } else {
        uint word2 = v_weights[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return half_to_float_lo(h);
    }
}

// Load 4 i8 values as a packed u32 from Q8_0 block
uint load_q8_packed4(uint block_byte, uint qs_idx) {
    uint byte_offset = block_byte + 2 + qs_idx;  // +2 to skip scale
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;

    if (byte_in_word == 0) {
        return v_weights[word_idx];
    } else {
        uint w0 = v_weights[word_idx];
        uint w1 = v_weights[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/16), batch, topk)
//   16 output columns per workgroup (4 warps * 4 cols/warp)

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint warp = gl_LocalInvocationID.y;
    uint wg_x = gl_WorkGroupID.x;
    uint batch_idx = gl_WorkGroupID.y;
    uint topk_idx = gl_WorkGroupID.z;

    // Each warp handles 4 columns, 8 lanes per column
    uint col_in_warp = lane / 8;   // 0-3: which output column within warp
    uint lane_in_col = lane % 8;   // 0-7: position within column team

    uint out_col = wg_x * (NWARPS * COLS_PER_WARP) + warp * COLS_PER_WARP + col_in_warp;

    if (out_col >= op_n || batch_idx >= op_batch || topk_idx >= op_topk) {
        return;
    }

    // Expert indirection
    uint expert_id = v_ids[batch_idx * op_topk + topk_idx];
    uint num_blocks = op_k / QK8_0;
    uint row_bytes = num_blocks * QK8_0_BYTES;
    uint expert_byte_offset = expert_id * op_expert_stride * 4;
    uint weight_byte_offset = expert_byte_offset + out_col * row_bytes;

    // Input X pointer
    uint x_inner_idx = min(topk_idx, op_x_inner_dim - 1);
    uint x_offset = batch_idx * op_x_stride_batch + x_inner_idx * op_x_stride_inner;

    float acc = 0.0;

    // Each lane processes 4 elements per Q8_0 block (8 lanes * 4 = 32 elements)
    for (uint blk = 0; blk < num_blocks; blk++) {
        uint block_byte = weight_byte_offset + blk * QK8_0_BYTES;

        // Load scale — lane 0 of each column team loads, then broadcast
        float scale;
        if (lane_in_col == 0) {
            scale = load_q8_scale(block_byte);
        }
        scale = subgroupShuffle(scale, col_in_warp * 8);

        // Each lane processes 4 consecutive i8 values
        uint qs_base = lane_in_col * 4;  // 0, 4, 8, 12, 16, 20, 24, 28
        uint k_base = blk * QK8_0 + qs_base;

        // Load 4 quantized values as packed i8
        uint packed_q = load_q8_packed4(block_byte, qs_base);

        // Load 4 activation values
        float a0 = v_input_x[x_offset + k_base + 0];
        float a1 = v_input_x[x_offset + k_base + 1];
        float a2 = v_input_x[x_offset + k_base + 2];
        float a3 = v_input_x[x_offset + k_base + 3];

        // Unpack i8 values and compute dot product
        int q0 = int(packed_q << 24) >> 24;
        int q1 = int(packed_q << 16) >> 24;
        int q2 = int(packed_q << 8) >> 24;
        int q3 = int(packed_q) >> 24;

        float partial = a0 * float(q0) + a1 * float(q1) + a2 * float(q2) + a3 * float(q3);
        acc += scale * partial;
    }

    // 8-lane reduction within each column team
    acc += subgroupShuffleXor(acc, 4);
    acc += subgroupShuffleXor(acc, 2);
    acc += subgroupShuffleXor(acc, 1);

    // Lane 0 of each column team writes the result
    if (lane_in_col == 0) {
        uint out_idx = batch_idx * op_topk * op_n + topk_idx * op_n + out_col;
        v_dest[out_idx] = acc;
    }
}
