// Indexed MoE Gate+Up+SwiGLU Fused - Q6_K Quantized
//
// Computes: output[batch, topk, n] = silu(gate[expert, n, k] @ x) * (up[expert, n, k] @ x)
// Where expert_id = ids[batch, topk]
//
// Fuses gate projection, up projection, and SwiGLU into a single dispatch.
// Uses vectorized u32 loads for scale decoding (2 loads instead of 8 byte loads).

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q6_K constants
#define QK6_K 256        // Elements per Q6_K block
#define QK6_K_BYTES 210  // Bytes per block
#define QL_OFFSET 0
#define QL_SIZE 128
#define QH_OFFSET 128
#define QH_SIZE 64
#define SCALES_OFFSET 192
#define SCALES_SIZE 16
#define D_OFFSET 208

#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (48 bytes = 12 x u32)
layout(push_constant) uniform PushConstants {
    uint params[12];
    // [0]: n_ff (out_dim)
    // [1]: k (in_dim)
    // [2]: batch
    // [3]: topk
    // [4]: x_inner_dim
    // [5]: gate_expert_stride (u32 words per expert)
    // [6]: up_expert_stride (u32 words per expert)
    // [7]: x_stride_batch
    // [8]: x_stride_inner
    // [9-11]: unused
};

#define op_n                  params[0]
#define op_k                  params[1]
#define op_batch              params[2]
#define op_topk               params[3]
#define op_x_inner_dim        params[4]
#define op_gate_expert_stride params[5]
#define op_up_expert_stride   params[6]
#define op_x_stride_batch     params[7]
#define op_x_stride_inner     params[8]

layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

layout(set = 0, binding = 1, std430) readonly buffer InputX {
    float v_input_x[];
};

layout(set = 0, binding = 2, std430) readonly buffer GateWeightsBuf {
    uint v_gate_weights[];
};

layout(set = 0, binding = 3, std430) readonly buffer UpWeightsBuf {
    uint v_up_weights[];
};

layout(set = 0, binding = 4, std430) readonly buffer IdsBuf {
    uint v_ids[];
};

// ============================================================================
// Gate weight helpers
// ============================================================================

uint gate_load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    return (v_gate_weights[word_idx] >> (byte_in_word * 8)) & 0xFF;
}

int gate_load_i8(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_gate_weights[word_idx];
    int val = int(word >> (byte_in_word * 8)) << 24 >> 24;
    return val;
}

uint gate_load_u32(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    if (byte_in_word == 0) {
        return v_gate_weights[word_idx];
    } else {
        uint w0 = v_gate_weights[word_idx];
        uint w1 = v_gate_weights[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

float gate_load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_gate_weights[word_idx];

    if (byte_in_word == 0) {
        return unpackHalf2x16(word).x;
    } else if (byte_in_word == 2) {
        return unpackHalf2x16(word).y;
    } else {
        uint word2 = v_gate_weights[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return unpackHalf2x16(h).x;
    }
}

// ============================================================================
// Up weight helpers
// ============================================================================

uint up_load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    return (v_up_weights[word_idx] >> (byte_in_word * 8)) & 0xFF;
}

int up_load_i8(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_up_weights[word_idx];
    int val = int(word >> (byte_in_word * 8)) << 24 >> 24;
    return val;
}

uint up_load_u32(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    if (byte_in_word == 0) {
        return v_up_weights[word_idx];
    } else {
        uint w0 = v_up_weights[word_idx];
        uint w1 = v_up_weights[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

float up_load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_up_weights[word_idx];

    if (byte_in_word == 0) {
        return unpackHalf2x16(word).x;
    } else if (byte_in_word == 2) {
        return unpackHalf2x16(word).y;
    } else {
        uint word2 = v_up_weights[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return unpackHalf2x16(h).x;
    }
}

// ============================================================================
// Common helpers
// ============================================================================

float warp_reduce_sum(float v) {
    v += subgroupShuffleXor(v, 16);
    v += subgroupShuffleXor(v, 8);
    v += subgroupShuffleXor(v, 4);
    v += subgroupShuffleXor(v, 2);
    v += subgroupShuffleXor(v, 1);
    return v;
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/4), batch, topk)

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint warp = gl_LocalInvocationID.y;
    uint wg_x = gl_WorkGroupID.x;
    uint batch_idx = gl_WorkGroupID.y;
    uint topk_idx = gl_WorkGroupID.z;

    uint out_col = wg_x * NWARPS + warp;

    if (out_col >= op_n || batch_idx >= op_batch || topk_idx >= op_topk) {
        return;
    }

    // Expert indirection
    uint expert_id = v_ids[batch_idx * op_topk + topk_idx];
    uint num_blocks = op_k / QK6_K;
    uint row_bytes = num_blocks * QK6_K_BYTES;
    uint gate_byte_offset = expert_id * op_gate_expert_stride * 4 + out_col * row_bytes;
    uint up_byte_offset = expert_id * op_up_expert_stride * 4 + out_col * row_bytes;

    // Input X pointer
    uint x_inner_idx = min(topk_idx, op_x_inner_dim - 1);
    uint x_offset = batch_idx * op_x_stride_batch + x_inner_idx * op_x_stride_inner;

    float gate_acc = 0.0;
    float up_acc = 0.0;

    for (uint blk = 0; blk < num_blocks; blk++) {
        uint gate_block_byte = gate_byte_offset + blk * QK6_K_BYTES;
        uint up_block_byte = up_byte_offset + blk * QK6_K_BYTES;
        uint k_base = blk * QK6_K;

        float gate_d = gate_load_f16(gate_block_byte + D_OFFSET);
        float up_d = up_load_f16(up_block_byte + D_OFFSET);

        // Process 256 elements in 2 half-blocks of 128
        for (uint n = 0; n < 256; n += 128) {
            uint idx = n / 128;
            uint gate_sc_base = gate_block_byte + SCALES_OFFSET + 8 * idx;
            uint gate_ql_base = gate_block_byte + QL_OFFSET + 64 * idx;
            uint gate_qh_base = gate_block_byte + QH_OFFSET + 32 * idx;

            uint up_sc_base = up_block_byte + SCALES_OFFSET + 8 * idx;
            uint up_ql_base = up_block_byte + QL_OFFSET + 64 * idx;
            uint up_qh_base = up_block_byte + QH_OFFSET + 32 * idx;

            // First pass: l = 0..15
            {
                // Vectorized scale load for gate: 8 i8 scales as 2 u32 words
                uint gate_sw0 = gate_load_u32(gate_sc_base);
                uint gate_sw1 = gate_load_u32(gate_sc_base + 4);
                // Extract even-indexed scales (indices 0, 2, 4, 6)
                float gate_scale0 = float(int(gate_sw0 << 24) >> 24);         // sc[0]
                float gate_scale1 = float(int(gate_sw0 << 8) >> 24);          // sc[2]
                float gate_scale2 = float(int(gate_sw1 << 24) >> 24);         // sc[4]
                float gate_scale3 = float(int(gate_sw1 << 8) >> 24);          // sc[6]

                uint up_sw0 = up_load_u32(up_sc_base);
                uint up_sw1 = up_load_u32(up_sc_base + 4);
                float up_scale0 = float(int(up_sw0 << 24) >> 24);
                float up_scale1 = float(int(up_sw0 << 8) >> 24);
                float up_scale2 = float(int(up_sw1 << 24) >> 24);
                float up_scale3 = float(int(up_sw1 << 8) >> 24);

                if (lane < 16) {
                    uint l = lane;

                    uint gate_ql1 = gate_load_byte(gate_ql_base + l);
                    uint gate_ql2 = gate_load_byte(gate_ql_base + l + 32);
                    uint gate_qh1 = gate_load_byte(gate_qh_base + l);

                    int gate_q1 = int((gate_ql1 & 0xF) | ((gate_qh1 & 3) << 4)) - 32;
                    int gate_q2 = int((gate_ql2 & 0xF) | (((gate_qh1 >> 2) & 3) << 4)) - 32;
                    int gate_q3 = int((gate_ql1 >> 4) | (((gate_qh1 >> 4) & 3) << 4)) - 32;
                    int gate_q4 = int((gate_ql2 >> 4) | (((gate_qh1 >> 6) & 3) << 4)) - 32;

                    uint up_ql1 = up_load_byte(up_ql_base + l);
                    uint up_ql2 = up_load_byte(up_ql_base + l + 32);
                    uint up_qh1 = up_load_byte(up_qh_base + l);

                    int up_q1 = int((up_ql1 & 0xF) | ((up_qh1 & 3) << 4)) - 32;
                    int up_q2 = int((up_ql2 & 0xF) | (((up_qh1 >> 2) & 3) << 4)) - 32;
                    int up_q3 = int((up_ql1 >> 4) | (((up_qh1 >> 4) & 3) << 4)) - 32;
                    int up_q4 = int((up_ql2 >> 4) | (((up_qh1 >> 6) & 3) << 4)) - 32;

                    // Load input X values (shared between gate and up)
                    uint k0 = k_base + n + l;
                    uint k1 = k_base + n + l + 32;
                    uint k2 = k_base + n + l + 64;
                    uint k3 = k_base + n + l + 96;

                    float a0 = v_input_x[x_offset + k0];
                    float a1 = v_input_x[x_offset + k1];
                    float a2 = v_input_x[x_offset + k2];
                    float a3 = v_input_x[x_offset + k3];

                    gate_acc += a0 * gate_d * gate_scale0 * float(gate_q1);
                    gate_acc += a1 * gate_d * gate_scale1 * float(gate_q2);
                    gate_acc += a2 * gate_d * gate_scale2 * float(gate_q3);
                    gate_acc += a3 * gate_d * gate_scale3 * float(gate_q4);

                    up_acc += a0 * up_d * up_scale0 * float(up_q1);
                    up_acc += a1 * up_d * up_scale1 * float(up_q2);
                    up_acc += a2 * up_d * up_scale2 * float(up_q3);
                    up_acc += a3 * up_d * up_scale3 * float(up_q4);
                }
            }

            // Second pass: l = 16..31
            {
                // Vectorized scale load for gate: extract odd-indexed scales (indices 1, 3, 5, 7)
                uint gate_sw0 = gate_load_u32(gate_sc_base);
                uint gate_sw1 = gate_load_u32(gate_sc_base + 4);
                float gate_scale0 = float(int(gate_sw0 << 16) >> 24);         // sc[1]
                float gate_scale1 = float(int(gate_sw0) >> 24);               // sc[3]
                float gate_scale2 = float(int(gate_sw1 << 16) >> 24);         // sc[5]
                float gate_scale3 = float(int(gate_sw1) >> 24);               // sc[7]

                uint up_sw0 = up_load_u32(up_sc_base);
                uint up_sw1 = up_load_u32(up_sc_base + 4);
                float up_scale0 = float(int(up_sw0 << 16) >> 24);
                float up_scale1 = float(int(up_sw0) >> 24);
                float up_scale2 = float(int(up_sw1 << 16) >> 24);
                float up_scale3 = float(int(up_sw1) >> 24);

                if (lane < 16) {
                    uint l = lane + 16;

                    uint gate_ql1 = gate_load_byte(gate_ql_base + l);
                    uint gate_ql2 = gate_load_byte(gate_ql_base + l + 32);
                    uint gate_qh1 = gate_load_byte(gate_qh_base + l);

                    int gate_q1 = int((gate_ql1 & 0xF) | ((gate_qh1 & 3) << 4)) - 32;
                    int gate_q2 = int((gate_ql2 & 0xF) | (((gate_qh1 >> 2) & 3) << 4)) - 32;
                    int gate_q3 = int((gate_ql1 >> 4) | (((gate_qh1 >> 4) & 3) << 4)) - 32;
                    int gate_q4 = int((gate_ql2 >> 4) | (((gate_qh1 >> 6) & 3) << 4)) - 32;

                    uint up_ql1 = up_load_byte(up_ql_base + l);
                    uint up_ql2 = up_load_byte(up_ql_base + l + 32);
                    uint up_qh1 = up_load_byte(up_qh_base + l);

                    int up_q1 = int((up_ql1 & 0xF) | ((up_qh1 & 3) << 4)) - 32;
                    int up_q2 = int((up_ql2 & 0xF) | (((up_qh1 >> 2) & 3) << 4)) - 32;
                    int up_q3 = int((up_ql1 >> 4) | (((up_qh1 >> 4) & 3) << 4)) - 32;
                    int up_q4 = int((up_ql2 >> 4) | (((up_qh1 >> 6) & 3) << 4)) - 32;

                    // Load input X values (shared between gate and up)
                    uint k0 = k_base + n + l;
                    uint k1 = k_base + n + l + 32;
                    uint k2 = k_base + n + l + 64;
                    uint k3 = k_base + n + l + 96;

                    float a0 = v_input_x[x_offset + k0];
                    float a1 = v_input_x[x_offset + k1];
                    float a2 = v_input_x[x_offset + k2];
                    float a3 = v_input_x[x_offset + k3];

                    gate_acc += a0 * gate_d * gate_scale0 * float(gate_q1);
                    gate_acc += a1 * gate_d * gate_scale1 * float(gate_q2);
                    gate_acc += a2 * gate_d * gate_scale2 * float(gate_q3);
                    gate_acc += a3 * gate_d * gate_scale3 * float(gate_q4);

                    up_acc += a0 * up_d * up_scale0 * float(up_q1);
                    up_acc += a1 * up_d * up_scale1 * float(up_q2);
                    up_acc += a2 * up_d * up_scale2 * float(up_q3);
                    up_acc += a3 * up_d * up_scale3 * float(up_q4);
                }
            }
        }
    }

    float gate_sum = warp_reduce_sum(gate_acc);
    float up_sum = warp_reduce_sum(up_acc);

    if (lane == 0) {
        float silu_gate = gate_sum / (1.0 + exp(-gate_sum));
        uint out_idx = batch_idx * op_topk * op_n + topk_idx * op_n + out_col;
        v_dest[out_idx] = silu_gate * up_sum;
    }
}
