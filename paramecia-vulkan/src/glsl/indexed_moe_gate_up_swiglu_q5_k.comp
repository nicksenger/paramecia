// Indexed MoE Gate+Up+SwiGLU Fused - Q5_K Quantized
//
// Computes: output[batch, topk, n] = silu(gate[expert, n, k] @ x) * (up[expert, n, k] @ x)
// Where expert_id = ids[batch, topk]
//
// Fuses gate projection, up projection, and SwiGLU into a single dispatch.
// Uses vectorized u32 loads for scale decoding (3 loads instead of 12 byte loads).
// Q5_K adds a high-bit array (qh) that provides bit 4 for each 4-bit value.

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Q5_K constants
#define QK5_K 256        // Elements per Q5_K block
#define QK5_K_BYTES 176  // Bytes per block
#define D_OFFSET 0
#define DMIN_OFFSET 2
#define SCALES_OFFSET 4
#define QH_OFFSET 16
#define QS_OFFSET 48

#define WARP_SIZE 32
#define NWARPS 4

layout(local_size_x = WARP_SIZE, local_size_y = NWARPS, local_size_z = 1) in;

// Parameters via push constants (48 bytes = 12 x u32)
layout(push_constant) uniform PushConstants {
    uint params[12];
    // [0]: n_ff (out_dim)
    // [1]: k (in_dim)
    // [2]: batch
    // [3]: topk
    // [4]: x_inner_dim
    // [5]: gate_expert_stride (u32 words per expert)
    // [6]: up_expert_stride (u32 words per expert)
    // [7]: x_stride_batch
    // [8]: x_stride_inner
    // [9-11]: unused
};

#define op_n                  params[0]
#define op_k                  params[1]
#define op_batch              params[2]
#define op_topk               params[3]
#define op_x_inner_dim        params[4]
#define op_gate_expert_stride params[5]
#define op_up_expert_stride   params[6]
#define op_x_stride_batch     params[7]
#define op_x_stride_inner     params[8]

layout(set = 0, binding = 0, std430) writeonly buffer OutputBuf {
    float v_dest[];
};

layout(set = 0, binding = 1, std430) readonly buffer InputX {
    float v_input_x[];
};

layout(set = 0, binding = 2, std430) readonly buffer GateWeightsBuf {
    uint v_gate_weights[];
};

layout(set = 0, binding = 3, std430) readonly buffer UpWeightsBuf {
    uint v_up_weights[];
};

layout(set = 0, binding = 4, std430) readonly buffer IdsBuf {
    uint v_ids[];
};

// ============================================================================
// Gate weight helpers
// ============================================================================

uint gate_load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    return (v_gate_weights[word_idx] >> (byte_in_word * 8)) & 0xFF;
}

uint gate_load_u32(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    if (byte_in_word == 0) {
        return v_gate_weights[word_idx];
    } else {
        uint w0 = v_gate_weights[word_idx];
        uint w1 = v_gate_weights[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

float gate_load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_gate_weights[word_idx];

    if (byte_in_word == 0) {
        return unpackHalf2x16(word).x;
    } else if (byte_in_word == 2) {
        return unpackHalf2x16(word).y;
    } else {
        uint word2 = v_gate_weights[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return unpackHalf2x16(h).x;
    }
}

void gate_get_q5k_scale_min(uint block_byte, uint is, out float d_scaled, out float m_scaled) {
    float d = gate_load_f16(block_byte + D_OFFSET);
    float dmin = gate_load_f16(block_byte + DMIN_OFFSET);

    uint sc_offset = block_byte + SCALES_OFFSET;
    // Vectorized: 3 u32 loads instead of 12 byte loads
    uint w0 = gate_load_u32(sc_offset);
    uint w1 = gate_load_u32(sc_offset + 4);
    uint w2 = gate_load_u32(sc_offset + 8);

    uint b0 = w0 & 0xFF; uint b1 = (w0 >> 8) & 0xFF;
    uint b2 = (w0 >> 16) & 0xFF; uint b3 = (w0 >> 24) & 0xFF;
    uint b4 = w1 & 0xFF; uint b5 = (w1 >> 8) & 0xFF;
    uint b6 = (w1 >> 16) & 0xFF; uint b7 = (w1 >> 24) & 0xFF;
    uint b8 = w2 & 0xFF; uint b9 = (w2 >> 8) & 0xFF;
    uint b10 = (w2 >> 16) & 0xFF; uint b11 = (w2 >> 24) & 0xFF;

    uint sc, mn;
    if (is < 4) {
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_hi = uint[](b4, b5, b6, b7);
        sc = b_lo[is] & 0x3F;
        mn = b_hi[is] & 0x3F;
    } else {
        uint[4] b_hi2 = uint[](b8, b9, b10, b11);
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_mid = uint[](b4, b5, b6, b7);
        uint idx = is - 4;
        uint q_is4 = b_hi2[idx];
        uint q_is4n = b_lo[idx];
        uint q_is = b_mid[idx];
        sc = (q_is4 & 0xF) | (((q_is4n >> 6) & 0x3) << 4);
        mn = ((q_is4 >> 4) & 0xF) | (((q_is >> 6) & 0x3) << 4);
    }

    d_scaled = d * float(sc);
    m_scaled = dmin * float(mn);
}

// ============================================================================
// Up weight helpers
// ============================================================================

uint up_load_byte(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    return (v_up_weights[word_idx] >> (byte_in_word * 8)) & 0xFF;
}

uint up_load_u32(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    if (byte_in_word == 0) {
        return v_up_weights[word_idx];
    } else {
        uint w0 = v_up_weights[word_idx];
        uint w1 = v_up_weights[word_idx + 1];
        return (w0 >> (byte_in_word * 8)) | (w1 << ((4 - byte_in_word) * 8));
    }
}

float up_load_f16(uint byte_offset) {
    uint word_idx = byte_offset / 4;
    uint byte_in_word = byte_offset % 4;
    uint word = v_up_weights[word_idx];

    if (byte_in_word == 0) {
        return unpackHalf2x16(word).x;
    } else if (byte_in_word == 2) {
        return unpackHalf2x16(word).y;
    } else {
        uint word2 = v_up_weights[word_idx + 1];
        uint h;
        if (byte_in_word == 1) {
            h = (word >> 8) | (word2 << 24);
        } else {
            h = (word >> 24) | (word2 << 8);
        }
        return unpackHalf2x16(h).x;
    }
}

void up_get_q5k_scale_min(uint block_byte, uint is, out float d_scaled, out float m_scaled) {
    float d = up_load_f16(block_byte + D_OFFSET);
    float dmin = up_load_f16(block_byte + DMIN_OFFSET);

    uint sc_offset = block_byte + SCALES_OFFSET;
    uint w0 = up_load_u32(sc_offset);
    uint w1 = up_load_u32(sc_offset + 4);
    uint w2 = up_load_u32(sc_offset + 8);

    uint b0 = w0 & 0xFF; uint b1 = (w0 >> 8) & 0xFF;
    uint b2 = (w0 >> 16) & 0xFF; uint b3 = (w0 >> 24) & 0xFF;
    uint b4 = w1 & 0xFF; uint b5 = (w1 >> 8) & 0xFF;
    uint b6 = (w1 >> 16) & 0xFF; uint b7 = (w1 >> 24) & 0xFF;
    uint b8 = w2 & 0xFF; uint b9 = (w2 >> 8) & 0xFF;
    uint b10 = (w2 >> 16) & 0xFF; uint b11 = (w2 >> 24) & 0xFF;

    uint sc, mn;
    if (is < 4) {
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_hi = uint[](b4, b5, b6, b7);
        sc = b_lo[is] & 0x3F;
        mn = b_hi[is] & 0x3F;
    } else {
        uint[4] b_hi2 = uint[](b8, b9, b10, b11);
        uint[4] b_lo = uint[](b0, b1, b2, b3);
        uint[4] b_mid = uint[](b4, b5, b6, b7);
        uint idx = is - 4;
        uint q_is4 = b_hi2[idx];
        uint q_is4n = b_lo[idx];
        uint q_is = b_mid[idx];
        sc = (q_is4 & 0xF) | (((q_is4n >> 6) & 0x3) << 4);
        mn = ((q_is4 >> 4) & 0xF) | (((q_is >> 6) & 0x3) << 4);
    }

    d_scaled = d * float(sc);
    m_scaled = dmin * float(mn);
}

// ============================================================================
// Common helpers
// ============================================================================

float warp_reduce_sum(float v) {
    v += subgroupShuffleXor(v, 16);
    v += subgroupShuffleXor(v, 8);
    v += subgroupShuffleXor(v, 4);
    v += subgroupShuffleXor(v, 2);
    v += subgroupShuffleXor(v, 1);
    return v;
}

// ============================================================================
// Main kernel
// ============================================================================
// Dispatch: (ceil(n/4), batch, topk)

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint warp = gl_LocalInvocationID.y;
    uint wg_x = gl_WorkGroupID.x;
    uint batch_idx = gl_WorkGroupID.y;
    uint topk_idx = gl_WorkGroupID.z;

    uint out_col = wg_x * NWARPS + warp;

    if (out_col >= op_n || batch_idx >= op_batch || topk_idx >= op_topk) {
        return;
    }

    // Expert indirection
    uint expert_id = v_ids[batch_idx * op_topk + topk_idx];
    uint num_blocks = op_k / QK5_K;
    uint row_bytes = num_blocks * QK5_K_BYTES;
    uint gate_byte_offset = expert_id * op_gate_expert_stride * 4 + out_col * row_bytes;
    uint up_byte_offset = expert_id * op_up_expert_stride * 4 + out_col * row_bytes;

    // Input X pointer
    uint x_inner_idx = min(topk_idx, op_x_inner_dim - 1);
    uint x_offset = batch_idx * op_x_stride_batch + x_inner_idx * op_x_stride_inner;

    float gate_acc = 0.0;
    float up_acc = 0.0;

    for (uint blk = 0; blk < num_blocks; blk++) {
        uint gate_block_byte = gate_byte_offset + blk * QK5_K_BYTES;
        uint up_block_byte = up_byte_offset + blk * QK5_K_BYTES;
        uint k_base = blk * QK5_K;

        for (uint j = 0; j < QK5_K; j += 64) {
            uint is = j / 32;

            float gate_d1, gate_m1, gate_d2, gate_m2;
            gate_get_q5k_scale_min(gate_block_byte, is, gate_d1, gate_m1);
            gate_get_q5k_scale_min(gate_block_byte, is + 1, gate_d2, gate_m2);

            float up_d1, up_m1, up_d2, up_m2;
            up_get_q5k_scale_min(up_block_byte, is, up_d1, up_m1);
            up_get_q5k_scale_min(up_block_byte, is + 1, up_d2, up_m2);

            uint gate_qs_base = gate_block_byte + QS_OFFSET + j / 2;
            uint up_qs_base = up_block_byte + QS_OFFSET + j / 2;

            if (lane < 32) {
                uint q_idx = lane;

                // Gate: load qs bytes and extract 4-bit values
                uint gate_qs_byte = gate_load_byte(gate_qs_base + q_idx);
                uint gate_q_lo = gate_qs_byte & 0xF;
                uint gate_q_hi = (gate_qs_byte >> 4) & 0xF;

                // Gate: load high bits from qh
                uint gate_qh_byte = gate_load_byte(gate_block_byte + QH_OFFSET + q_idx);
                uint gate_hm1 = 1u << (is % 8);
                uint gate_hm2 = 1u << ((is + 1) % 8);
                uint gate_h_lo = (gate_qh_byte & gate_hm1) != 0 ? 16u : 0u;
                uint gate_h_hi = (gate_qh_byte & gate_hm2) != 0 ? 16u : 0u;

                // Gate: full 5-bit values
                uint gate_q5_lo = gate_q_lo + gate_h_lo;
                uint gate_q5_hi = gate_q_hi + gate_h_hi;

                // Up: load qs bytes and extract 4-bit values
                uint up_qs_byte = up_load_byte(up_qs_base + q_idx);
                uint up_q_lo = up_qs_byte & 0xF;
                uint up_q_hi = (up_qs_byte >> 4) & 0xF;

                // Up: load high bits from qh
                uint up_qh_byte = up_load_byte(up_block_byte + QH_OFFSET + q_idx);
                uint up_hm1 = 1u << (is % 8);
                uint up_hm2 = 1u << ((is + 1) % 8);
                uint up_h_lo = (up_qh_byte & up_hm1) != 0 ? 16u : 0u;
                uint up_h_hi = (up_qh_byte & up_hm2) != 0 ? 16u : 0u;

                // Up: full 5-bit values
                uint up_q5_lo = up_q_lo + up_h_lo;
                uint up_q5_hi = up_q_hi + up_h_hi;

                // Load input X values (shared between gate and up)
                uint k_lo = k_base + j + q_idx;
                uint k_hi = k_base + j + 32 + q_idx;
                float a_lo = v_input_x[x_offset + k_lo];
                float a_hi = v_input_x[x_offset + k_hi];

                float gate_v_lo = gate_d1 * float(gate_q5_lo) - gate_m1;
                float gate_v_hi = gate_d2 * float(gate_q5_hi) - gate_m2;
                gate_acc += a_lo * gate_v_lo + a_hi * gate_v_hi;

                float up_v_lo = up_d1 * float(up_q5_lo) - up_m1;
                float up_v_hi = up_d2 * float(up_q5_hi) - up_m2;
                up_acc += a_lo * up_v_lo + a_hi * up_v_hi;
            }
        }
    }

    float gate_sum = warp_reduce_sum(gate_acc);
    float up_sum = warp_reduce_sum(up_acc);

    if (lane == 0) {
        float silu_gate = gate_sum / (1.0 + exp(-gate_sum));
        uint out_idx = batch_idx * op_topk * op_n + topk_idx * op_n + out_col;
        v_dest[out_idx] = silu_gate * up_sum;
    }
}
